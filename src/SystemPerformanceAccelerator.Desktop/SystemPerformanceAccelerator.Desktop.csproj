<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Branding\PC-SPA-Taskbar.ico</ApplicationIcon>
    <AssemblyName>PC-SPA</AssemblyName>
    <RootNamespace>SystemPerformanceAccelerator.Desktop</RootNamespace>
    <Title>PC-SPA</Title>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <Product>PC-SPA</Product>
    <Description>PC-SPA — local Windows system cleanup, analysis, and optimization utility.</Description>
    <Authors>Vikramsinh Parmar</Authors>
    <Company>PC-SPA</Company>
    <Copyright>Copyright © 2026 PC-SPA</Copyright>
    <RepositoryUrl>https://github.com/Vikramsinh29/SystemPerformanceAccelerator-AI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Branding\*.png" />
    <Resource Include="Assets\Branding\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SystemPerformanceAccelerator.Core\SystemPerformanceAccelerator.Core.csproj" />
    <ProjectReference Include="..\SystemPerformanceAccelerator.Infrastructure\SystemPerformanceAccelerator.Infrastructure.csproj" />
    <ProjectReference Include="..\SystemPerformanceAccelerator.PrivilegedHelper\SystemPerformanceAccelerator.PrivilegedHelper.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyPrivilegedHelperToBuildOutput" AfterTargets="Build">
    <ItemGroup>
      <PrivilegedHelperBuildOutput Include="$(MSBuildProjectDirectory)\..\SystemPerformanceAccelerator.PrivilegedHelper\bin\$(Configuration)\$(TargetFramework)\PC-SPA.PrivilegedHelper.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PrivilegedHelperBuildOutput)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="'@(PrivilegedHelperBuildOutput)' != ''" />
  </Target>

  <Target Name="CopyPrivilegedHelperToPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <PrivilegedHelperPublishOutput Include="$(MSBuildProjectDirectory)\..\SystemPerformanceAccelerator.PrivilegedHelper\bin\$(Configuration)\$(TargetFramework)\PC-SPA.PrivilegedHelper.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PrivilegedHelperPublishOutput)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'@(PrivilegedHelperPublishOutput)' != ''" />
  </Target>
</Project>
