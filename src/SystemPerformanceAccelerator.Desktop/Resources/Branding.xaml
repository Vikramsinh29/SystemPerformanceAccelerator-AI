<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BitmapImage x:Key="BrandPhoenixDarkSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Phoenix-About-2x.png"
                 CacheOption="OnLoad" />
    <BitmapImage x:Key="BrandPhoenixLightSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Phoenix-Light.png"
                 CacheOption="OnLoad" />
    <BitmapImage x:Key="BrandWordmarkDarkSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Wordmark-About-2x.png"
                 CacheOption="OnLoad" />
    <BitmapImage x:Key="BrandWordmarkLightSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Wordmark-Light.png"
                 CacheOption="OnLoad" />
    <BitmapImage x:Key="BrandFullLockupDarkSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Full-Lockup-Dark.png"
                 CacheOption="OnLoad" />
    <BitmapImage x:Key="BrandTitlebarPhoenixSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Phoenix-Titlebar-4x.png"
                 CacheOption="OnLoad" />
    <BitmapImage x:Key="BrandTitlebarWordmarkSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Wordmark-Titlebar-4x.png"
                 CacheOption="OnLoad" />
    <BitmapImage x:Key="BrandSidebarPhoenixSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Phoenix-Sidebar-2x.png"
                 CacheOption="OnLoad" />
    <BitmapImage x:Key="BrandSidebarWordmarkSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Wordmark-Sidebar-2x.png"
                 CacheOption="OnLoad" />
    <BitmapImage x:Key="BrandSplashSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Full-Lockup-Splash.png"
                 CacheOption="OnLoad" />

    <!-- Runtime aliases are replaced by ThemeManager whenever the theme changes. -->
    <BitmapImage x:Key="BrandPhoenixSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Phoenix-Dark.png"
                 CacheOption="OnLoad" />
    <BitmapImage x:Key="BrandWordmarkSource"
                 UriSource="pack://application:,,,/PC-SPA;component/Assets/Branding/PC-SPA-Wordmark-Dark.png"
                 CacheOption="OnLoad" />

    <Style x:Key="BrandImageStyle" TargetType="Image">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="BrandProductNameStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="BrandDescriptorStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="BrandAboutCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource FluentElevatedCardStyle}">
        <Setter Property="Padding" Value="22" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLarge}" />
    </Style>
</ResourceDictionary>
