<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FluentCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLarge}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="FluentElevatedCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PremiumDividerBrush}" />
        <Setter Property="Padding" Value="{StaticResource ElevatedCardPadding}" />
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
    </Style>

    <Style x:Key="FluentBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GoldMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusPill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PremiumHeroCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource FluentElevatedCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusXLarge}" />
    </Style>

    <Style x:Key="PremiumInsetCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
    </Style>
</ResourceDictionary>
