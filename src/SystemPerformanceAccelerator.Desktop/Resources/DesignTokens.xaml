<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeCaption">10</sys:Double>
    <sys:Double x:Key="FontSizeMeta">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">12.5</sys:Double>
    <sys:Double x:Key="FontSizeSection">14</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">25</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">31</sys:Double>

    <!-- Spacing -->
    <sys:Double x:Key="Space2">2</sys:Double>
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space6">6</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space10">10</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space20">20</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>

    <Thickness x:Key="ControlPadding">14,0</Thickness>
    <Thickness x:Key="CardPadding">18,16</Thickness>
    <Thickness x:Key="ElevatedCardPadding">20,18</Thickness>
    <Thickness x:Key="PageContentPadding">24,22</Thickness>

    <!-- Shape -->
    <CornerRadius x:Key="CornerRadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">10</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">14</CornerRadius>
    <CornerRadius x:Key="CornerRadiusPill">999</CornerRadius>

    <!-- Elevation and restrained premium glow -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="22"
                      Direction="270"
                      Opacity="0.16"
                      ShadowDepth="4"
                      Color="#000000" />
    <DropShadowEffect x:Key="FlyoutShadowEffect"
                      BlurRadius="34"
                      Direction="270"
                      Opacity="0.34"
                      ShadowDepth="10"
                      Color="#000000" />
    <DropShadowEffect x:Key="GoldGlowEffect"
                      BlurRadius="18"
                      Direction="0"
                      Opacity="0.10"
                      ShadowDepth="0"
                      Color="#D9B34C" />
    <DropShadowEffect x:Key="SubtleGoldGlowEffect"
                      BlurRadius="10"
                      Direction="0"
                      Opacity="0.07"
                      ShadowDepth="0"
                      Color="#CDA744" />
</ResourceDictionary>
