<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:presentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

    <SolidColorBrush x:Key="AppBackgroundBrush" presentationOptions:Freeze="False" Color="#F3F5F8" />
    <SolidColorBrush x:Key="SurfaceBrush" presentationOptions:Freeze="False" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" presentationOptions:Freeze="False" Color="#F7F8FA" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" presentationOptions:Freeze="False" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" presentationOptions:Freeze="False" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" presentationOptions:Freeze="False" Color="#D5DAE2" />
    <SolidColorBrush x:Key="TextPrimaryBrush" presentationOptions:Freeze="False" Color="#1B1F2A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" presentationOptions:Freeze="False" Color="#667085" />
    <SolidColorBrush x:Key="TextTertiaryBrush" presentationOptions:Freeze="False" Color="#98A2B3" />
    <SolidColorBrush x:Key="BorderBrush" presentationOptions:Freeze="False" Color="#E3E7ED" />
    <SolidColorBrush x:Key="BorderStrongBrush" presentationOptions:Freeze="False" Color="#CDD3DC" />
    <SolidColorBrush x:Key="DataGridHeaderBrush" presentationOptions:Freeze="False" Color="#F7F8FA" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" presentationOptions:Freeze="False" Color="#F7FAFC" />
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" presentationOptions:Freeze="False" Color="#EAF3FF" />
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" presentationOptions:Freeze="False" Color="#344054" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" presentationOptions:Freeze="False" Color="#D0D5DD" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" presentationOptions:Freeze="False" Color="#F9FAFB" />
    <SolidColorBrush x:Key="ProgressTrackBrush" presentationOptions:Freeze="False" Color="#EAECF0" />
    <SolidColorBrush x:Key="MetaTextBrush" presentationOptions:Freeze="False" Color="#475467" />

    <SolidColorBrush x:Key="AccentBrush" presentationOptions:Freeze="False" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentHoverBrush" presentationOptions:Freeze="False" Color="#115EA3" />
    <SolidColorBrush x:Key="AccentPressedBrush" presentationOptions:Freeze="False" Color="#0C3B5E" />
    <SolidColorBrush x:Key="AccentSoftBrush" presentationOptions:Freeze="False" Color="#E7F3FF" />
    <SolidColorBrush x:Key="FocusBrush" presentationOptions:Freeze="False" Color="#4F9EEA" />
    <SolidColorBrush x:Key="SuccessBrush" presentationOptions:Freeze="False" Color="#107C41" />
    <SolidColorBrush x:Key="SuccessSoftBrush" presentationOptions:Freeze="False" Color="#E8F5EE" />
    <SolidColorBrush x:Key="WarningBrush" presentationOptions:Freeze="False" Color="#CA5010" />
    <SolidColorBrush x:Key="WarningSoftBrush" presentationOptions:Freeze="False" Color="#FFF4E5" />
    <SolidColorBrush x:Key="DangerBrush" presentationOptions:Freeze="False" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" presentationOptions:Freeze="False" Color="#FDECEC" />

    <SolidColorBrush x:Key="SidebarBrush" presentationOptions:Freeze="False" Color="#111827" />
    <SolidColorBrush x:Key="SidebarHoverBrush" presentationOptions:Freeze="False" Color="#1F2937" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" presentationOptions:Freeze="False" Color="#0F6CBD" />
    <SolidColorBrush x:Key="SidebarTextBrush" presentationOptions:Freeze="False" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SidebarMutedTextBrush" presentationOptions:Freeze="False" Color="#9CA3AF" />
    <SolidColorBrush x:Key="SidebarDividerBrush" presentationOptions:Freeze="False" Color="#2A3443" />
    <SolidColorBrush x:Key="SidebarPanelBrush" presentationOptions:Freeze="False" Color="#0C1420" />

    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="18"
                      Direction="270"
                      Opacity="0.10"
                      ShadowDepth="4"
                      Color="#101828" />
    <DropShadowEffect x:Key="FlyoutShadowEffect"
                      BlurRadius="28"
                      Direction="270"
                      Opacity="0.16"
                      ShadowDepth="8"
                      Color="#101828" />
</ResourceDictionary>
