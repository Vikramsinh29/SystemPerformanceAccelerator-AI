<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PremiumLineIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppIconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="PremiumSuccessIconStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PremiumLineIconStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style x:Key="PremiumWarningIconStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PremiumLineIconStyle}">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <Style x:Key="PremiumDangerIconStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PremiumLineIconStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
</ResourceDictionary>
