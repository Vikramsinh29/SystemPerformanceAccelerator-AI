<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FluentProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressGradientBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Border x:Name="PART_Track" Margin="1" Background="Transparent" />
                        <Border x:Name="PART_Indicator"
                                Margin="1"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3" />
                        <Border x:Name="IndeterminateGlow"
                                Width="72"
                                Margin="1"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentHoverGradientBrush}"
                                CornerRadius="3"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform X="-90" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0" />
                            <Setter TargetName="IndeterminateGlow" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateGlow"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-90"
                                                         To="520"
                                                         Duration="0:0:1.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FullTrackActivityProgressBarStyle"
           TargetType="ProgressBar"
           BasedOn="{StaticResource FluentProgressBarStyle}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" />
                        <Border x:Name="PART_Track"
                                Margin="1"
                                Background="Transparent" />
                        <Border x:Name="PART_Indicator"
                                Margin="1"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3" />
                        <Border x:Name="FullTrackActivity"
                                Margin="1"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"
                                Opacity="0">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0.5"
                                                     EndPoint="1,0.5">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-0.425" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="Transparent" Offset="0.35" />
                                    <GradientStop Color="White" Offset="0.425" />
                                    <GradientStop Color="White" Offset="0.575" />
                                    <GradientStop Color="Transparent" Offset="0.65" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0" />
                            <Setter TargetName="FullTrackActivity" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FullTrackActivityStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FullTrackActivity"
                                                         Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.425"
                                                         To="0.425"
                                                         Duration="0:0:1.8"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FullTrackActivityStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PremiumStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Effect" Value="{StaticResource SubtleGoldGlowEffect}" />
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource FluentProgressBarStyle}" />
</ResourceDictionary>
