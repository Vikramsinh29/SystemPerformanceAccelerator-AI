                                                    Background="{DynamicResource SuccessSoftBrush}"
                                                    CornerRadius="11">
                                                <TextBlock Text="&#xE946;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Margin="0,12,0,0"
                                                       Text="Why it matters"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Recommendation.WhyItMatters}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Padding="17,15"
                                            Background="{DynamicResource WarningSoftBrush}"
                                            BorderBrush="{DynamicResource WarningBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
