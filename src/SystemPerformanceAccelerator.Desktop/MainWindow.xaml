                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Margin="8,0,0,0"
                                                           Text="Warning and safety"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{Binding SelectedFinding.SafetyNotice}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource FluentCardStyle}"
                                            Padding="17,15">
                                        <StackPanel>
                                            <TextBlock Text="AVAILABLE ACTION" Style="{StaticResource FluentCaptionStyle}" />
                                            <TextBlock Margin="0,7,0,0"
                                                       Text="{Binding SelectedFinding.AvailableAction}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />

                                            <WrapPanel Margin="0,13,0,0">
                                                <WrapPanel.Style>
                                                    <Style TargetType="WrapPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedFinding.ShowDiskActions}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </WrapPanel.Style>
                                                <Button Command="{Binding SelectedFinding.OpenCleanerCommand}"
                                                        Style="{StaticResource FluentPrimaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Content="Open Cleaner" />
                                                <Button Command="{Binding SelectedFinding.OpenLargeFileFinderCommand}"
                                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Content="Open Large File Finder" />
                                                <Button Command="{Binding SelectedFinding.OpenDuplicateFileFinderCommand}"
                                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Content="Open Duplicate Finder" />
                                            </WrapPanel>

                                            <Button Command="{Binding SelectedFinding.OpenSystemMonitorCommand}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,13,0,0"
                                                    Content="Open System Monitor">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FluentPrimaryButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedFinding.ShowSystemMonitorAction}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Command="{Binding SelectedFinding.OpenStartupManagerCommand}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,13,0,0"
                                                    Content="Open Startup Manager">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FluentPrimaryButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedFinding.ShowStartupManagerAction}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2"
                                Padding="17,12"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock Margin="9,0,0,0"
                                           Text="Health Check never applies changes directly. Each action opens the relevant safety-controlled tool for review and explicit confirmation."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  Visibility="{Binding IsCleanerContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,14"
                        Padding="22,18"
                        Style="{StaticResource FluentElevatedCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="52"
                                Height="52"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="16"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,22,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Temporary file cleanup"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="Review current-user Windows temporary files, select only what you want removed, and keep every cleanup under explicit confirmation."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       MaxWidth="570" />

                            <Border Margin="0,10,0,0"
                                    Padding="9,5"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SuccessSoftBrush}"
                                    CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0"
                                               Text="Manual review • confirmation required"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Width="292"
                                    VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding ScanCommand}"
                                        Style="{StaticResource FluentPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="7,0,0,0"
                                                   Text="Scan now"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding CleanCommand}"
                                        Style="{StaticResource CleanButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="7,0,0,0"
                                                   Text="Clean selected"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Button Margin="0,8,0,0"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Margin="7,0,0,0"
                                               Text="Cancel current operation"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="FILES FOUND"
                                           Style="{StaticResource FluentCaptionStyle}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding FilesFound}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="25"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Available for review"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="RECLAIMABLE SPACE"
                                           Style="{StaticResource FluentCaptionStyle}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ReclaimableSpace}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="25"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="From current scan results"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Background="{DynamicResource SuccessSoftBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4"
                            Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="CURRENT ACTIVITY"
                                           Style="{StaticResource FluentCaptionStyle}" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding ScanStatus}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ScanStatus}" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding Progress, StringFormat='Progress {0}%'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Background="{DynamicResource WarningSoftBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <TextBlock Text="&#xE823;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Padding="0"
                        Style="{StaticResource FluentElevatedCardStyle}"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="20,16,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Cleanup candidates"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Select individual files for cleanup. The full path remains visible for review before confirmation."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Style="{StaticResource FluentBadgeStyle}">
                                <TextBlock Text="{Binding ScanStatus}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="180"
                                           ToolTip="{Binding ScanStatus}" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="CleanerResultsGrid"
                                      ItemsSource="{Binding Candidates}"
                                      Style="{StaticResource FluentDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      BorderThickness="0"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      AlternationCount="2"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="SELECT" Width="74">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Focusable="False"
                                                          IsTabStop="False" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="FILE NAME"
                                                        Binding="{Binding Name}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="2*"
                                                        MinWidth="180" />
                                    <DataGridTextColumn Header="SIZE"
                                                        Binding="{Binding Size}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="105" />
                                    <DataGridTextColumn Header="MODIFIED"
                                                        Binding="{Binding LastModified, StringFormat={}{0:dd MMM yyyy  HH:mm}}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="170" />
                                    <DataGridTextColumn Header="LOCATION"
                                                        Binding="{Binding FullPath}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="3*"
                                                        MinWidth="240" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Background="{DynamicResource SurfaceBrush}"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=CleanerResultsGrid, Path=HasItems}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="420">
                                    <Border Width="58"
                                            Height="58"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="18"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="23"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Margin="0,14,0,0"
                                               Text="No cleanup candidates yet"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Run a scan to review temporary files. Nothing is selected or removed automatically."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE946;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="CLEANER STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding Progress, StringFormat='Progress {0}%'}"
                                           Foreground="{DynamicResource MetaTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding CustomClean}"
                  Visibility="{Binding DataContext.IsCustomCleanContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,14"
                        Padding="22,18"
                        Style="{StaticResource FluentElevatedCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="52"
                                Height="52"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="16"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,22,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Custom cleanup preview"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="Choose cleanup categories, preview every matching file, and clean only after explicit confirmation. Nothing is selected or removed automatically."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       MaxWidth="570" />

                            <Border Margin="0,10,0,0"
                                    Padding="9,5"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SuccessSoftBrush}"
                                    CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0"
                                               Text="Preview first • confirmation required"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Width="324"
                                    VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding PreviewCommand}"
                                        Style="{StaticResource FluentPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="7,0,0,0"
                                                   Text="Preview selected"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding CleanCommand}"
                                        Style="{StaticResource CleanButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="7,0,0,0"
                                                   Text="Clean previewed"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Button Margin="0,8,0,0"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Margin="7,0,0,0"
                                               Text="Cancel current operation"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="CLEANUP CATEGORY"
                                           Style="{StaticResource FluentCaptionStyle}" />
                                <CheckBox Margin="0,7,0,0"
                                          IsChecked="{Binding IncludeTemporaryFiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Content="Current-user temporary files"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="12.5"
                                          FontWeight="SemiBold"
                                          Cursor="Hand">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox"
                                               BasedOn="{StaticResource FluentCheckBoxStyle}">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <TextBlock Margin="0,5,0,0"
                                           Text="Uses the existing safe Cleaner scanner."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <TextBlock Text="&#xE8EF;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="CATEGORIES SELECTED"
                                           Style="{StaticResource FluentCaptionStyle}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding SelectedCategoriesText}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Included in the next preview"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4"
                            Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="FILES FOUND"
                                           Style="{StaticResource FluentCaptionStyle}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding FilesFound}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Available for review"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Background="{DynamicResource WarningSoftBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="6"
                            Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="RECLAIMABLE SPACE"
                                           Style="{StaticResource FluentCaptionStyle}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ReclaimableSpace}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="From the current preview"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Background="{DynamicResource SuccessSoftBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Padding="0"
                        Style="{StaticResource FluentElevatedCardStyle}"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="20,16,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Previewed cleanup files"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Review category, file name, size, modified date, and full location before requesting cleanup."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Style="{StaticResource FluentBadgeStyle}">
                                <TextBlock Text="{Binding PreviewStatus}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="190" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="CustomCleanResultsGrid"
                                      ItemsSource="{Binding Results}"
                                      Style="{StaticResource FluentDataGridStyle}"
                                      behaviors:DataGridSelectionBehavior.IsEnabled="False"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      BorderThickness="0"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      AlternationCount="2"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CATEGORY"
                                                        Binding="{Binding Category}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="1.4*"
                                                        MinWidth="150" />
                                    <DataGridTextColumn Header="FILE NAME"
                                                        Binding="{Binding Name}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="1.6*"
                                                        MinWidth="160" />
                                    <DataGridTextColumn Header="SIZE"
                                                        Binding="{Binding Size}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="100" />
                                    <DataGridTextColumn Header="MODIFIED"
                                                        Binding="{Binding LastModified, StringFormat={}{0:dd MMM yyyy  HH:mm}}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="165" />
                                    <DataGridTextColumn Header="LOCATION"
                                                        Binding="{Binding FullPath}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="2.6*"
                                                        MinWidth="240" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Background="{DynamicResource SurfaceBrush}"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=CustomCleanResultsGrid, Path=HasItems}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="430">
                                    <Border Width="58"
                                            Height="58"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="18"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="23"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Margin="0,14,0,0"
                                               Text="No custom-clean preview yet"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Choose at least one category and run Preview selected. Cleanup remains unavailable until preview results are ready."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="CUSTOM CLEAN STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding Progress, StringFormat='Progress {0}%'}"
                                           Foreground="{DynamicResource MetaTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding AutoCleanSchedule}"
                  Visibility="{Binding DataContext.IsAutoCleanScheduleContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.Resources>
                    <Style x:Key="ScheduleSurfaceCardStyle"
                           TargetType="Border"
                           BasedOn="{StaticResource FluentCardStyle}">
                        <Setter Property="CornerRadius" Value="12" />
                    </Style>
                    <Style x:Key="ScheduleSectionTitleStyle"
                           TargetType="TextBlock"
                           BasedOn="{StaticResource FluentSectionTitleStyle}" />
                    <Style x:Key="ScheduleFieldLabelStyle"
                           TargetType="TextBlock"
                           BasedOn="{StaticResource FluentCaptionStyle}">
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="FontSize" Value="11" />
                    </Style>
                    <Style x:Key="ScheduleListItemStyle" TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ScheduleCard"
                                            Padding="18,15"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Cursor="Hand">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ScheduleCard" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ScheduleCard" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="ScheduleCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="ScheduleCard" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!-- Premium schedule overview -->
                <Grid Visibility="{Binding IsOverviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.45*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="20,16" Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ScheduleMetricIconStyle}"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Saved schedules" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding ScheduleCountText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Padding="20,16" Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ScheduleMetricIconStyle}"
                                        Background="{DynamicResource SuccessSoftBrush}">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Enabled" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding EnabledScheduleCountText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Padding="20,16" Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ScheduleMetricIconStyle}"
                                        Background="{DynamicResource WarningSoftBrush}">
                                    <TextBlock Text="&#xE823;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Next planned run" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding NextPlannedRunText}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding NextPlannedRunText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,14,0,12"
                            Padding="16,12"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Planning only — you remain in control"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Schedules are stored locally. They calculate future run times and support manual previews only; nothing runs or deletes files automatically."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource ScheduleSurfaceCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="22,18,22,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Your schedules" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Create separate plans for daily, weekly, or monthly maintenance."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding NewScheduleCommand}"
                                        Content="Create schedule"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="22,0,22,0">
                                <ListBox ItemsSource="{Binding Schedules}"
                                         SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource ScheduleListItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Visibility="{Binding HasSchedules, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Style="{StaticResource ScheduleMetricIconStyle}"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="&#xE823;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding FrequencyText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Text="{Binding CategoriesText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NextRunCaption}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="10" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding NextRunText}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border Grid.Column="4"
                                                        Margin="16,0,0,0"
                                                        Padding="11,5"
                                                        CornerRadius="12"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Padding="34"
                                        Background="Transparent"
                                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                        <Border Width="62" Height="62" Background="{DynamicResource AccentSoftBrush}" CornerRadius="18" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE787;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="25"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Margin="0,18,0,0"
                                                   Text="No schedules yet"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="Create your first local maintenance plan. Each new schedule is saved separately and can be edited later."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Margin="0,18,0,0"
                                                Command="{Binding NewScheduleCommand}"
                                                Content="Create first schedule"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="22,12"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedScheduleSummary}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding EditSelectedScheduleCommand}"
                                                Content="Edit selected"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0" />
                                        <Button Command="{Binding RemoveScheduleCommand}"
                                                Content="Remove"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Style="{StaticResource OperationStatusPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE946;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AUTO CLEAN SCHEDULE STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Dedicated create/edit page -->
                <Grid Visibility="{Binding IsEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding BackToSchedulesCommand}"
                                Content="←  Back to schedules"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EditorTitle}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding EditorSubtitle}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border MaxWidth="850"
                                Padding="28,24"
                                HorizontalAlignment="Center"
                                Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12">
                                        <TextBlock Text="&#xE787;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Schedule details" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Choose when this local maintenance plan should be considered due."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,22,0,0" Text="Schedule name" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                <TextBox Height="42"
                                         Text="{Binding ScheduleName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="80"
                                         Style="{StaticResource InputTextBoxStyle}" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Frequency" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <ComboBox Height="42"
                                                  ItemsSource="{Binding Frequencies}"
                                                  SelectedItem="{Binding Frequency, Mode=TwoWay}"
                                                  Style="{StaticResource InputComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Local time (HH:mm)" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <TextBox Height="42"
                                                 Text="{Binding RunAtLocalTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <StackPanel Visibility="{Binding IsWeeklyFrequency, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Day of week" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <ComboBox Height="42"
                                                  ItemsSource="{Binding WeekDays}"
                                                  SelectedItem="{Binding WeeklyDay, Mode=TwoWay}"
                                                  Style="{StaticResource InputComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsMonthlyFrequency, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Day of month (1–31)" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <TextBox Height="42"
                                                 Text="{Binding MonthlyDayText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,24,0,0"
                                        Padding="18,16"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="Cleaner categories" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Only existing, safety-reviewed Cleaner categories can be included."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11" />
                                        <CheckBox Margin="0,14,0,0"
                                                  IsChecked="{Binding IncludeTemporaryFiles, Mode=TwoWay}"
                                                  Content="Current-user temporary files"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  Cursor="Hand" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,16,0,0"
                                        Padding="18,16"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Next planned run" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding EditorNextRunText}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsScheduleEnabled, Mode=TwoWay}"
                                                  Content="Enable schedule"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,16,0,0"
                                        Padding="18,16"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Preview this plan" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="Scan the selected categories without deleting or changing files."
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Command="{Binding PreviewNowCommand}"
                                                        Content="Preview now"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="0,0,8,0" />
                                                <Button Command="{Binding CancelPreviewCommand}"
                                                        Content="Cancel"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <ProgressBar Grid.Row="1"
                                                     Margin="0,14,0,0"
                                                     Height="5"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding PreviewProgress, Mode=OneWay}"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Background="{DynamicResource ProgressTrackBrush}" />

                                        <Grid Grid.Row="2" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource OperationMetaChipStyle}">
                                                <TextBlock Text="{Binding PreviewFilesFound, StringFormat='Files: {0}'}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                                <TextBlock Text="{Binding PreviewReclaimableSpace, StringFormat='Space: {0}'}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Grid.Column="4" Style="{StaticResource OperationMetaChipStyle}">
                                                <TextBlock Text="{Binding PreviewIssues, StringFormat='Issues: {0}'}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding PreviewStatus}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock Margin="0,18,0,0"
                                           Text="Local storage"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SchedulesPath}"
                                           ToolTip="{Binding SchedulesPath}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="16,12"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Status}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                <Button Command="{Binding BackToSchedulesCommand}"
                                        Content="Cancel"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0" />
                                <Button Command="{Binding SaveScheduleCommand}"
                                        Content="{Binding SaveButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding LargeFileFinder}"
                  Visibility="{Binding DataContext.IsLargeFileFinderContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="FILES FOUND" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding FilesFound}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TOTAL MATCHED SIZE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding TotalSize}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SCAN STATUS / TIME" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,7,0,0" Text="{Binding ScanStatus}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Margin="0,16,0,12" Padding="16,14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="300" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" MinWidth="130" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FOLDER OR DRIVE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding SelectedFolder}"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                    <Button Grid.Column="2" Command="{Binding BrowseCommand}" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MINIMUM SIZE (MB)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBox Margin="0,6,0,0"
                                         Text="{Binding MinimumSizeText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         HorizontalContentAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding ScanCommand}" Content="Scan" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding DeleteSelectedCommand}" Content="Delete selected" Style="{StaticResource CleanButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid x:Name="LargeFilesGrid"
                              ItemsSource="{Binding Results}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="True"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              Background="{DynamicResource SurfaceBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SELECT" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FILE NAME" Binding="{Binding Name}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="2*" MinWidth="190" />
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="110" />
                            <DataGridTextColumn Header="MODIFIED" Binding="{Binding LastModified, StringFormat={}{0:dd MMM yyyy  HH:mm}}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="170" />
                            <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="3*" MinWidth="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE7C3;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="LARGE FILE OPERATION STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Row="3"
                                   Margin="45,7,0,0"
                                   Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding DuplicateFileFinder}"
                  Visibility="{Binding DataContext.IsDuplicateFileFinderContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="DUPLICATE GROUPS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding GroupsFound}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CONFIRMED FILES" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding DuplicateFiles}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="POTENTIAL RECLAIMABLE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding PotentialReclaimableSpace}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Margin="0,16,0,12" Padding="16,14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="FOLDER OR DRIVE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding SelectedFolder}"
                                         Style="{StaticResource InputTextBoxStyle}" />
                                <Button Grid.Column="2" Command="{Binding BrowseCommand}" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" />
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding SelectionSummary}"
                                       ToolTip="{Binding SelectionSummary}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Command="{Binding ScanCommand}" Content="Scan" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                                <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                                <Button Command="{Binding RecycleSelectedCommand}" Content="Recycle Selected" Style="{StaticResource CleanButtonStyle}" MinWidth="145" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid x:Name="DuplicateFilesGrid"
                              ItemsSource="{Binding GroupedResults}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="True"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              Background="{DynamicResource SurfaceMutedBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              FrozenColumnCount="1"
                              MinColumnWidth="54"
                              HorizontalContentAlignment="Stretch"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell"
                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Height" Value="38" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,10"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="34"
                                                        Height="34"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        CornerRadius="17">
                                                    <TextBlock Text="&#xE8B7;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="15"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Items[0].GroupTitle}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Items[0].GroupCopiesDisplay}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11" />
                                                        <TextBlock Margin="8,0" Text="&#x2022;" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Items[0].GroupRemovalGuidance}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="3"
                                                        Padding="10,6"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="EACH FILE"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding Items[0].GroupSizeDisplay}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="5"
                                                        Padding="10,6"
                                                        Background="{DynamicResource SuccessSoftBrush}"
                                                        BorderBrush="{DynamicResource SuccessBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="RECLAIMABLE"
                                                                   Foreground="{DynamicResource SuccessBrush}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding Items[0].GroupReclaimableDisplay}"
                                                                   Foreground="{DynamicResource SuccessBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Margin" Value="0,8,0,10" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="0,1,0,1"
                                                            CornerRadius="0"
                                                            ClipToBounds="True"
                                                            HorizontalAlignment="Stretch">
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <ContentPresenter Grid.Row="0"
                                                                              Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                              HorizontalAlignment="Stretch" />
                                                            <ItemsPresenter Grid.Row="1"
                                                                            HorizontalAlignment="Stretch" />
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SELECT"
                                                    Width="58"
                                                    MinWidth="58"
                                                    MaxWidth="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FILE NAME"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="2*"
                                                MinWidth="220" />
                            <DataGridTextColumn Header="SIZE"
                                                Binding="{Binding SizeDisplay}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="90"
                                                MinWidth="90"
                                                MaxWidth="110" />
                            <DataGridTextColumn Header="MODIFIED"
                                                Binding="{Binding LastModified, StringFormat={}{0:g}}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="145"
                                                MinWidth="135"
                                                MaxWidth="175" />
                            <DataGridTextColumn Header="LOCATION"
                                                Binding="{Binding Location}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="3*"
                                                MinWidth="320" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="DUPLICATE OPERATION STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Row="3"
                                   Margin="45,7,0,0"
                                   Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding StartupManager}"
                  Visibility="{Binding DataContext.IsStartupManagerContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="STARTUP ITEMS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding ItemsFound}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ENABLED" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding EnabledItems}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="DISABLED" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding DisabledItems}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Margin="0,16,0,12" Padding="16,14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="READ-ONLY STARTUP INVENTORY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="Registry Run entries and current-user/all-users Startup folders. Nothing can be enabled, disabled, edited, or removed here."
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ScanCommand}" Content="Scan" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Results}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Background="{DynamicResource SurfaceBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="1.2*"
                                                MinWidth="90" />
                            <DataGridTextColumn Header="COMMAND / PATH"
                                                Binding="{Binding Command}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="2.4*"
                                                MinWidth="150" />
                            <DataGridTextColumn Header="SOURCE"
                                                Binding="{Binding Source}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="1.5*"
                                                MinWidth="110" />
                            <DataGridTextColumn Header="LOCATION"
                                                Binding="{Binding Location}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="2*"
                                                MinWidth="140" />
                            <DataGridTextColumn Header="STATUS"
                                                Binding="{Binding Status}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="1.2*"
                                                MinWidth="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE768;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="STARTUP INVENTORY STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Margin="45,7,0,0"
                                   Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding SystemMonitor}"
                  Visibility="{Binding DataContext.IsSystemMonitorContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CPU USAGE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding CpuUsageText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MEMORY USAGE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding MemoryUsageText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MEMORY USED" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding UsedMemoryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,16,0,12"
                        Padding="16,14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="READ-ONLY LIVE MONITOR" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="Samples total system CPU usage and physical memory approximately once per second. It does not stop processes, optimize memory, or change Windows settings."
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="18,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding StartCommand}" Content="Start" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding StopCommand}" Content="Stop" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="20"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="TOTAL CPU" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,10,0,10"
                                       Text="{Binding CpuUsageText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="34"
                                       FontWeight="SemiBold" />
                            <ProgressBar Grid.Row="2"
                                         Height="12"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding CpuUsagePercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ProgressTrackBrush}" />
                            <TextBlock Grid.Row="3"
                                       Margin="0,14,0,0"
                                       Text="Overall processor activity across Windows"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="20"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="PHYSICAL MEMORY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,10,0,10"
                                       Text="{Binding MemoryUsageText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="34"
                                       FontWeight="SemiBold" />
                            <ProgressBar Grid.Row="2"
                                         Height="12"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding MemoryUsagePercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ProgressTrackBrush}" />

                            <Grid Grid.Row="3" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="USED" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding UsedMemoryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="AVAILABLE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding AvailableMemoryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TOTAL" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding TotalMemoryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE9D2;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="MONITOR STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding MonitoringState}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="45,7,0,0"
                                   Text="{Binding LastUpdated, StringFormat='Last updated: {0}'}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>


            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding Settings}"
                  Visibility="{Binding DataContext.IsSettingsContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Border Padding="18"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" MinWidth="180" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="1*" MinWidth="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="APPEARANCE"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Theme"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="System follows the current Windows app theme. Changes apply immediately."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          MinWidth="180"
                                          MaxWidth="300"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                          Style="{StaticResource InputComboBoxStyle}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="OPERATING DEFAULTS"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*" MinWidth="170" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1*" MinWidth="130" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1.55*" MinWidth="170" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Large File Finder default"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Minimum file size in MB used when the app starts."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding LargeFileMinimumSizeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="MB"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Column="4"
                                               Text="Allowed range: 1 MB to 1,048,576 MB."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Border Margin="0,14,0,14"
                                        Height="1"
                                        Background="{DynamicResource BorderBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*" MinWidth="170" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1*" MinWidth="130" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1.55*" MinWidth="170" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="System Monitor refresh"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Time between live CPU and memory updates."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SystemMonitorRefreshIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="seconds"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Column="4"
                                               Text="Allowed range: 1 to 10 seconds."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" MinWidth="170" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="2.2*" MinWidth="280" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SAFETY POLICY"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Cleanup confirmation"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <CheckBox IsChecked="{Binding ConfirmBeforeCleanup, Mode=OneWay}"
                                              IsEnabled="False"
                                              Content="Always require confirmation before cleanup"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="This safety setting is mandatory and cannot be disabled. System Performance Accelerator never deletes or recycles files without explicit confirmation."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="LOCAL STORAGE"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Settings are saved as a local JSON file. No cloud account, telemetry, or registry writing is used."
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding SettingsPath}"
                                           ToolTip="{Binding SettingsPath}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource OperationStatusIconStyle}">
                            <TextBlock Text="&#xE713;" Style="{StaticResource OperationStatusGlyphStyle}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="SETTINGS STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding Status}"
                                       ToolTip="{Binding Status}"
                                       Style="{StaticResource OperationStatusMessageStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding RestoreDefaultsCommand}"
                                    Content="Restore defaults"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Command="{Binding SaveCommand}"
                                    Content="Save settings"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>


        </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
