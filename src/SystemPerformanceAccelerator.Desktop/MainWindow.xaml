                                    <DataGridTextColumn Header="MODIFIED"
                                                        Binding="{Binding LastModified, StringFormat={}{0:dd MMM yyyy  HH:mm}}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="130"
                                                        MinWidth="126" />
                                    <DataGridTextColumn Header="LOCATION"
                                                        Binding="{Binding FullPath}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="1.7*"
                                                        MinWidth="155" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Background="{DynamicResource SurfaceBrush}"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=CustomCleanResultsGrid, Path=HasItems}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="430">
                                    <Border Width="58"
                                            Height="58"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="18"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="23"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Margin="0,14,0,0"
                                               Text="No custom-clean preview yet"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Choose at least one category and run Preview selected. Cleanup remains unavailable until preview results are ready."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="CUSTOM CLEAN STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding Progress, StringFormat='Progress {0}%'}"
                                           Foreground="{DynamicResource MetaTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  Height="{Binding ViewportHeight, ElementName=ToolContentScrollViewer, Converter={StaticResource SubtractDoubleConverter}, ConverterParameter=34}"
                  DataContext="{Binding AutoCleanSchedule}"
                  Visibility="{Binding DataContext.IsAutoCleanScheduleContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.Resources>
                    <Style x:Key="ScheduleSurfaceCardStyle"
                           TargetType="Border"
                           BasedOn="{StaticResource FluentElevatedCardStyle}">
                        <Setter Property="CornerRadius" Value="10" />
                    </Style>
                    <Style x:Key="ScheduleSectionTitleStyle"
                           TargetType="TextBlock"
                           BasedOn="{StaticResource FluentSectionTitleStyle}" />
                    <Style x:Key="ScheduleFieldLabelStyle"
                           TargetType="TextBlock"
                           BasedOn="{StaticResource FluentCaptionStyle}">
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="FontSize" Value="11" />
                    </Style>
                    <Style x:Key="ScheduleListItemStyle" TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ScheduleCard"
                                            Padding="18,15"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Cursor="Hand">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ScheduleCard" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ScheduleCard" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="ScheduleCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="ScheduleCard" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!-- Premium schedule overview -->
                <Grid Visibility="{Binding IsOverviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.45*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="20,16" Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SummaryMetricIconStyle}"
                                        Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="&#xE787;" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Saved schedules" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding ScheduleCountText}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Padding="20,16" Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SummaryMetricIconStyle}"
                                        Background="{DynamicResource SuccessSoftBrush}"><TextBlock Text="&#xE73E;" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Enabled" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding EnabledScheduleCountText}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Padding="20,16" Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SummaryMetricIconStyle}"
                                        Background="{DynamicResource WarningSoftBrush}"><TextBlock Text="&#xE823;" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Next planned run" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding NextPlannedRunText}"
                                               ToolTip="{Binding NextPlannedRunText}"
                                               Style="{StaticResource SummaryMetricCompactValueStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,14,0,12"
                            Padding="16,12"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30"
                                    Height="30"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Manual execution only — you remain in control"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Schedules are stored locally. Run now always performs a fresh preview, starts with nothing selected, and requires explicit confirmation. No cleanup runs unattended."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource ScheduleSurfaceCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="22,18,22,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Your schedules" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Create separate plans for daily, weekly, or monthly maintenance."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding NewScheduleCommand}"
                                        Style="{StaticResource FluentPrimaryButtonStyle}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Create schedule" VerticalAlignment="Center" /></StackPanel></Button>
                            </Grid>

                            <Grid Grid.Row="1" Margin="22,0,22,0">
                                <ListBox ItemsSource="{Binding Schedules}"
                                         SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource ScheduleListItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Visibility="{Binding HasSchedules, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Style="{StaticResource SummaryMetricIconStyle}"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        VerticalAlignment="Top"><TextBlock Text="&#xE823;" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding FrequencyText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Text="{Binding CategoriesText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Margin="0,7,0,0"
                                                               Text="{Binding LastManualRunText, StringFormat='Last manual run: {0}'}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding LastManualRunDetail}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NextRunCaption}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="10" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding NextRunText}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border Grid.Column="4"
                                                        Margin="16,0,0,0"
                                                        Padding="11,5"
                                                        CornerRadius="12"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Padding="34"
                                        Background="Transparent"
                                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                        <Border Width="62" Height="62" Background="{DynamicResource AccentSoftBrush}" CornerRadius="18" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE787;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="25"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Margin="0,18,0,0"
                                                   Text="No schedules yet"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="Create your first local maintenance plan. Each new schedule is saved separately and can be edited later."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Margin="0,18,0,0"
                                                Command="{Binding NewScheduleCommand}"
                                                Style="{StaticResource FluentPrimaryButtonStyle}"
                                                HorizontalAlignment="Center" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Create first schedule" VerticalAlignment="Center" /></StackPanel></Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="22,12"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedScheduleSummary}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding RunSelectedScheduleCommand}"
                                                CommandParameter="{Binding SelectedSchedule}"
                                                Style="{StaticResource FluentPrimaryButtonStyle}"
                                                Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Run now" VerticalAlignment="Center" /></StackPanel></Button>
                                        <Button Command="{Binding EditSelectedScheduleCommand}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Margin="0,0,8,0" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Edit selected" VerticalAlignment="Center" /></StackPanel></Button>
                                        <Button Command="{Binding RemoveScheduleCommand}"
                                                Style="{StaticResource FluentDangerButtonStyle}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Remove" VerticalAlignment="Center" /></StackPanel></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Style="{StaticResource OperationStatusPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE946;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AUTO CLEAN SCHEDULE STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Fresh preview and confirmed manual run page -->
                <Grid Visibility="{Binding IsRunReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding BackFromRunReviewCommand}"
                                Style="{StaticResource FluentSecondaryButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Back to schedules" VerticalAlignment="Center" /></StackPanel></Button>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RunScheduleName}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="Fresh manual cleanup review — no file begins selected"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="3" Style="{StaticResource FluentBadgeStyle}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RunScheduleStateText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <UniformGrid Grid.Row="1" Margin="-4,-4,-4,9" Columns="4">
                        <Border Style="{StaticResource ResponsiveSummaryCardStyle}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="FILES FOUND" Style="{StaticResource ResponsiveSummaryCardCaptionStyle}" /><TextBlock Margin="0,5,0,0" Text="{Binding RunFilesFound}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /><TextBlock Margin="0,3,0,0" Text="Fresh preview inventory" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" /></StackPanel>
                                <Border Grid.Column="1" Width="34" Height="34" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource ResponsiveSummaryCardStyle}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="SELECTED" Style="{StaticResource ResponsiveSummaryCardCaptionStyle}" /><TextBlock Margin="0,5,0,0" Text="{Binding RunSelectedFiles}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /><TextBlock Margin="0,3,0,0" Text="{Binding RunSelectedSpace}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" /></StackPanel>
                                <Border Grid.Column="1" Width="34" Height="34" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="10"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource ResponsiveSummaryCardStyle}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="RECLAIMABLE" Style="{StaticResource ResponsiveSummaryCardCaptionStyle}" /><TextBlock Margin="0,5,0,0" Text="{Binding RunReclaimableSpace}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" /><TextBlock Margin="0,3,0,0" Text="Across all previewed files" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" /></StackPanel>
                                <Border Grid.Column="1" Width="34" Height="34" Background="{DynamicResource WarningSoftBrush}" CornerRadius="10"><TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource ResponsiveSummaryCardStyle}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="SCAN ISSUES" Style="{StaticResource ResponsiveSummaryCardCaptionStyle}" /><TextBlock Margin="0,5,0,0" Text="{Binding RunIssueCount}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /><TextBlock Margin="0,3,0,0" Text="Skipped or inaccessible locations" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" /></StackPanel>
                                <Border Grid.Column="1" Width="34" Height="34" Background="{DynamicResource DangerSoftBrush}" CornerRadius="10"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DangerBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Padding="0" Style="{StaticResource ScheduleSurfaceCardStyle}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="20,16,20,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Fresh preview files" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                    <TextBlock Margin="0,3,0,0" Text="Select only files you reviewed. Cleanup revalidates every selected file immediately before deletion." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource FluentBadgeStyle}" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding RunPreviewStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold" MaxWidth="230" TextTrimming="CharacterEllipsis" /></Border>
                            </Grid>
                            <ProgressBar Grid.Row="1" Height="5" Minimum="0" Maximum="100" Value="{Binding RunProgress, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrackBrush}" />
                            <Grid Grid.Row="2">
                                <DataGrid x:Name="AutoCleanRunResultsGrid"
                                          ItemsSource="{Binding RunResults}"
                                          Style="{StaticResource FluentDataGridStyle}"
                                          behaviors:DataGridSelectionBehavior.IsEnabled="True"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          BorderThickness="0"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          AlternationCount="2"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="86">
                                            <DataGridTemplateColumn.Header><CheckBox IsChecked="{Binding DataContext.AreAllRunResultsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BulkSelectionHeaderCheckBoxStyle}" /></DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" Cursor="Hand" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="1.1*" MinWidth="118" />
                                        <DataGridTextColumn Header="FILE NAME" Binding="{Binding Name}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="1.5*" MinWidth="145" />
                                        <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="74" MinWidth="74" MaxWidth="82" />
                                        <DataGridTextColumn Header="MODIFIED" Binding="{Binding LastModified, StringFormat={}{0:dd MMM yyyy  HH:mm}}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="130" MinWidth="126" />
                                        <DataGridTextColumn Header="LOCATION" Binding="{Binding FullPath}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="1.7*" MinWidth="155" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ElementName=AutoCleanRunResultsGrid, Path=HasItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                        <Border Width="58" Height="58" Background="{DynamicResource AccentSoftBrush}" CornerRadius="18"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Margin="0,16,0,0" Text="{Binding RunPreviewStatus}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,6,0,0" Text="No files are selected or deleted automatically. A preview with zero files is also a valid safe result." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="3" Margin="16,10,16,0" Padding="12,9" Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Visibility="{Binding HasRunFirstIssue, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding RunFirstIssue, StringFormat='First scan issue: {0}'}" Foreground="{DynamicResource WarningBrush}" FontSize="10.5" TextWrapping="Wrap" /></Border>
                            <ContentControl Grid.Row="4" Margin="16,10,16,14" Content="{Binding RunOperationResult}" ContentTemplate="{StaticResource OperationResultSummaryTemplate}" Visibility="{Binding RunOperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource OperationStatusPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OperationStatusIconStyle}"><TextBlock Text="&#xE946;" Style="{StaticResource OperationStatusGlyphStyle}" /></Border>
                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center"><TextBlock Text="MANUAL AUTO CLEAN STATUS" Style="{StaticResource OperationStatusLabelStyle}" /><TextBlock Margin="0,3,0,0" Text="{Binding Status}" ToolTip="{Binding Status}" Style="{StaticResource OperationStatusMessageStyle}" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding CancelRunCommand}" Style="{StaticResource FluentSecondaryButtonStyle}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Cancel operation" VerticalAlignment="Center" /></StackPanel></Button>
                                <Button Command="{Binding CleanRunPreviewCommand}" Style="{StaticResource FluentSuccessButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Clean selected" VerticalAlignment="Center" /></StackPanel></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Dedicated create/edit page -->
                <Grid Visibility="{Binding IsEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding BackToSchedulesCommand}"
                                Style="{StaticResource FluentSecondaryButtonStyle}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="←  Back to schedules" VerticalAlignment="Center" /></StackPanel></Button>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EditorTitle}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding EditorSubtitle}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border MaxWidth="850"
                                Padding="28,24"
                                HorizontalAlignment="Center"
                                Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12">
                                        <TextBlock Text="&#xE787;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Schedule details" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Choose when this local maintenance plan should be considered due."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,22,0,0" Text="Schedule name" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                <TextBox Height="42"
                                         Text="{Binding ScheduleName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="80"
                                         Style="{StaticResource FluentTextBoxStyle}" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Frequency" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <ComboBox Height="42"
                                                  ItemsSource="{Binding Frequencies}"
                                                  SelectedItem="{Binding Frequency, Mode=TwoWay}"
                                                  Style="{StaticResource FluentComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Local time (HH:mm)" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <TextBox Height="42"
                                                 Text="{Binding RunAtLocalTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FluentTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <StackPanel Visibility="{Binding IsWeeklyFrequency, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Day of week" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <ComboBox Height="42"
                                                  ItemsSource="{Binding WeekDays}"
                                                  SelectedItem="{Binding WeeklyDay, Mode=TwoWay}"
                                                  Style="{StaticResource FluentComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsMonthlyFrequency, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Day of month (1–31)" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <TextBox Height="42"
                                                 Text="{Binding MonthlyDayText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FluentTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,24,0,0"
                                        Padding="18,16"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="Cleaner categories" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Only existing, safety-reviewed Cleaner categories can be included."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11" />
                                        <CheckBox Margin="0,14,0,0"
                                                  IsChecked="{Binding IncludeTemporaryFiles, Mode=TwoWay}"
                                                  Content="Current-user temporary files"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  Cursor="Hand" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,16,0,0"
                                        Padding="18,16"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Next planned run" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding EditorNextRunText}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsScheduleEnabled, Mode=TwoWay}"
                                                  Content="Enable schedule"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,16,0,0"
                                        Padding="18,16"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Preview this plan" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="Scan the selected categories without deleting or changing files."
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Command="{Binding PreviewNowCommand}"
                                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                                        Margin="0,0,8,0" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Preview now" VerticalAlignment="Center" /></StackPanel></Button>
                                                <Button Command="{Binding CancelPreviewCommand}"
                                                        Style="{StaticResource FluentSecondaryButtonStyle}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Cancel" VerticalAlignment="Center" /></StackPanel></Button>
                                            </StackPanel>
                                        </Grid>

                                        <ProgressBar Grid.Row="1"
                                                     Margin="0,14,0,0"
                                                     Height="5"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding PreviewProgress, Mode=OneWay}"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Background="{DynamicResource ProgressTrackBrush}" />

                                        <Grid Grid.Row="2" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource OperationMetaChipStyle}">
                                                <TextBlock Text="{Binding PreviewFilesFound, StringFormat='Files: {0}'}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                                <TextBlock Text="{Binding PreviewReclaimableSpace, StringFormat='Space: {0}'}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Grid.Column="4" Style="{StaticResource OperationMetaChipStyle}">
                                                <TextBlock Text="{Binding PreviewIssues, StringFormat='Issues: {0}'}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding PreviewStatus}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock Margin="0,18,0,0"
                                           Text="Local storage"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SchedulesPath}"
                                           ToolTip="{Binding SchedulesPath}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="16,12"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Status}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                <Button Command="{Binding BackToSchedulesCommand}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                        Margin="0,0,8,0" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Cancel" VerticalAlignment="Center" /></StackPanel></Button>
                                <Button Command="{Binding SaveScheduleCommand}"
                                        Style="{StaticResource FluentPrimaryButtonStyle}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="{Binding SaveButtonText}" VerticalAlignment="Center" /></StackPanel></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  Height="{Binding ViewportHeight, ElementName=ToolContentScrollViewer, Converter={StaticResource SubtractDoubleConverter}, ConverterParameter=34}"
                  DataContext="{Binding LargeFileFinder}"
                  Visibility="{Binding DataContext.IsLargeFileFinderContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource ModuleHeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                Style="{StaticResource ModuleHeroIconStyle}">
                            <TextBlock Text="&#xE7C3;"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Style="{StaticResource ModuleHeroGlyphStyle}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,22,0" VerticalAlignment="Center">
                            <TextBlock Text="Large file review" Style="{StaticResource ModuleHeroTitleStyle}" />
                            <TextBlock Text="Scan a folder or drive, review every result, then explicitly confirm any deletion."
                                       Style="{StaticResource ModuleHeroDescriptionStyle}" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="10,6" Background="{DynamicResource WarningSoftBrush}" CornerRadius="12" VerticalAlignment="Center">
                            <TextBlock Text="Preview first • confirmation required" Foreground="{DynamicResource WarningBrush}" FontSize="10.5" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="18,14" Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="&#xE8A5;" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="FILES FOUND" Style="{StaticResource FluentCaptionStyle}" />
                                <TextBlock Text="{Binding FilesFound}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Padding="18,14" Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource SuccessSoftBrush}"><TextBlock Text="&#xE8C8;" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL MATCHED SIZE" Style="{StaticResource FluentCaptionStyle}" />
                                <TextBlock Text="{Binding TotalSize}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Padding="18,14" Style="{StaticResource FluentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource SurfaceMutedBrush}"><TextBlock Text="&#xE823;" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SCAN STATUS / TIME" Style="{StaticResource FluentCaptionStyle}" />
                                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource SummaryMetricCompactValueStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="0,12,0,12" Padding="18,15" Style="{StaticResource FluentCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="300" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" MinWidth="130" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FOLDER OR DRIVE" Style="{StaticResource FluentCaptionStyle}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SelectedFolder}" Style="{StaticResource FluentTextBoxStyle}" />
                                    <Button Grid.Column="2" Command="{Binding BrowseCommand}" Style="{StaticResource FluentSecondaryButtonStyle}" MinWidth="90" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Browse" VerticalAlignment="Center" /></StackPanel></Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MINIMUM SIZE (MB)" Style="{StaticResource FluentCaptionStyle}" />
                                <TextBox Margin="0,7,0,0" Text="{Binding MinimumSizeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBoxStyle}" HorizontalContentAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="LargeFileActionPanel"
                                   Grid.Row="1"
                                   Margin="0,11,-8,-8"
                                   HorizontalAlignment="Right">
                            <Button Command="{Binding ScanCommand}" Style="{StaticResource FluentPrimaryButtonStyle}" Margin="{StaticResource ActionButtonSpacing}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Scan files" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Command="{Binding CancelCommand}" Style="{StaticResource FluentSecondaryButtonStyle}" Margin="{StaticResource ActionButtonSpacing}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Cancel" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource FluentDangerButtonStyle}" Margin="{StaticResource ActionButtonSpacing}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Delete selected" VerticalAlignment="Center" /></StackPanel></Button>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
<DataGrid x:Name="LargeFilesGrid"
                              Style="{StaticResource FluentDataGridStyle}"
                              ItemsSource="{Binding Results}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="True"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              Background="{DynamicResource SurfaceBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="86">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.AreAllResultsSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource BulkSelectionHeaderCheckBoxStyle}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FILE NAME" Binding="{Binding Name}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="2*" MinWidth="190" />
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="110" />
                            <DataGridTextColumn Header="MODIFIED" Binding="{Binding LastModified, StringFormat={}{0:dd MMM yyyy  HH:mm}}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="170" />
                            <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="3*" MinWidth="260" />
                        </DataGrid.Columns>
                    </DataGrid>

                        <Border Background="{DynamicResource SurfaceBrush}"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=LargeFilesGrid, Path=HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                <Border Width="58" Height="58" Background="{DynamicResource AccentSoftBrush}" CornerRadius="18" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="0,14,0,0" Text="No large files listed yet" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,5,0,0" Text="Choose a folder or drive and run Scan files. Nothing is selected or deleted automatically." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar x:Name="LargeFileActivityProgressBar"
                                     Style="{StaticResource FullTrackActivityProgressBarStyle}"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE7C3;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="LARGE FILE OPERATION STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Row="3"
                                   Margin="45,7,0,0"
                                   Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  Height="{Binding ViewportHeight, ElementName=ToolContentScrollViewer, Converter={StaticResource SubtractDoubleConverter}, ConverterParameter=34}"
                  DataContext="{Binding DuplicateFileFinder}"
                  Visibility="{Binding DataContext.IsDuplicateFileFinderContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModuleHeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentSoftBrush}" Style="{StaticResource ModuleHeroIconStyle}">
                            <TextBlock Text="&#xE8B7;" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource ModuleHeroGlyphStyle}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,22,0" VerticalAlignment="Center">
                            <TextBlock Text="Duplicate file review" Style="{StaticResource ModuleHeroTitleStyle}" />
                            <TextBlock Text="Confirm identical-content groups, select only extra copies, then explicitly approve Recycle Bin cleanup." Style="{StaticResource ModuleHeroDescriptionStyle}" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="10,6" Background="{DynamicResource WarningSoftBrush}" CornerRadius="12" VerticalAlignment="Center">
                            <TextBlock Text="Hash-confirmed • recycle only" Foreground="{DynamicResource WarningBrush}" FontSize="10.5" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="18,14" Style="{StaticResource FluentCardStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="&#xE8FD;" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="DUPLICATE GROUPS" Style="{StaticResource FluentCaptionStyle}" /><TextBlock Text="{Binding GroupsFound}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /></StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Padding="18,14" Style="{StaticResource FluentCardStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource SuccessSoftBrush}"><TextBlock Text="&#xE8A5;" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CONFIRMED FILES" Style="{StaticResource FluentCaptionStyle}" /><TextBlock Text="{Binding DuplicateFiles}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /></StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" Padding="18,14" Style="{StaticResource FluentCardStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource WarningSoftBrush}"><TextBlock Text="&#xE8C8;" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="POTENTIAL RECLAIMABLE" Style="{StaticResource FluentCaptionStyle}" /><TextBlock Text="{Binding PotentialReclaimableSpace}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /></StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="0,12,0,12" Padding="18,15" Style="{StaticResource FluentCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="FOLDER OR DRIVE" Style="{StaticResource FluentCaptionStyle}" />
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SelectedFolder}" Style="{StaticResource FluentTextBoxStyle}" />
                                <Button Grid.Column="2" Command="{Binding BrowseCommand}" Style="{StaticResource FluentSecondaryButtonStyle}" MinWidth="90" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Browse" VerticalAlignment="Center" /></StackPanel></Button>
                            </Grid>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectionSummary}" ToolTip="{Binding SelectionSummary}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <WrapPanel x:Name="DuplicateFileActionPanel"
                                       Grid.Column="2"
                                       Margin="0,0,-8,-8"
                                       HorizontalAlignment="Right">
                                <Button Command="{Binding ScanCommand}" Style="{StaticResource FluentPrimaryButtonStyle}" Margin="{StaticResource ActionButtonSpacing}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Scan duplicates" VerticalAlignment="Center" /></StackPanel></Button>
                                <Button Command="{Binding CancelCommand}" Style="{StaticResource FluentSecondaryButtonStyle}" Margin="{StaticResource ActionButtonSpacing}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Cancel" VerticalAlignment="Center" /></StackPanel></Button>
                                <Button Command="{Binding RecycleSelectedCommand}" Style="{StaticResource FluentDangerButtonStyle}" Margin="{StaticResource ActionButtonSpacing}" MinWidth="145" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Recycle selected" VerticalAlignment="Center" /></StackPanel></Button>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
<DataGrid x:Name="DuplicateFilesGrid"
                              Style="{StaticResource FluentDataGridStyle}"
                              ItemsSource="{Binding GroupedResults}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="True"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              Background="{DynamicResource SurfaceMutedBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              FrozenColumnCount="1"
                              MinColumnWidth="54"
                              HorizontalContentAlignment="Stretch"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,10"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="34"
                                                        Height="34"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        CornerRadius="17">
                                                    <TextBlock Text="&#xE8B7;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="15"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Items[0].GroupTitle}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Items[0].GroupCopiesDisplay}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11" />
                                                        <TextBlock Margin="8,0" Text="&#x2022;" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Items[0].GroupRemovalGuidance}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="3"
                                                        Padding="10,6"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="EACH FILE"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding Items[0].GroupSizeDisplay}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="5"
                                                        Padding="10,6"
                                                        Background="{DynamicResource SuccessSoftBrush}"
                                                        BorderBrush="{DynamicResource SuccessBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="RECLAIMABLE"
                                                                   Foreground="{DynamicResource SuccessBrush}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding Items[0].GroupReclaimableDisplay}"
                                                                   Foreground="{DynamicResource SuccessBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Margin" Value="0,8,0,10" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="0,1,0,1"
                                                            CornerRadius="0"
                                                            ClipToBounds="True"
                                                            HorizontalAlignment="Stretch">
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <ContentPresenter Grid.Row="0"
                                                                              Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                              HorizontalAlignment="Stretch" />
                                                            <ItemsPresenter Grid.Row="1"
                                                                            HorizontalAlignment="Stretch" />
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="86"
                                                    MinWidth="86"
                                                    MaxWidth="86">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.AreAllRemovableCopiesSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource BulkSelectionHeaderCheckBoxStyle}"
                                              ToolTip="Select every removable copy while keeping one verified copy in each group" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FILE NAME"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="2*"
                                                MinWidth="220" />
                            <DataGridTextColumn Header="SIZE"
                                                Binding="{Binding SizeDisplay}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="90"
                                                MinWidth="90"
                                                MaxWidth="110" />
                            <DataGridTextColumn Header="MODIFIED"
                                                Binding="{Binding LastModified, StringFormat={}{0:g}}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="145"
                                                MinWidth="135"
                                                MaxWidth="175" />
                            <DataGridTextColumn Header="LOCATION"
                                                Binding="{Binding Location}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="3*"
                                                MinWidth="320" />
                        </DataGrid.Columns>
                    </DataGrid>

                        <Border Background="{DynamicResource SurfaceBrush}"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=DuplicateFilesGrid, Path=HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                <Border Width="58" Height="58" Background="{DynamicResource AccentSoftBrush}" CornerRadius="18" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="0,14,0,0" Text="No duplicate groups listed yet" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,5,0,0" Text="Choose a folder and run Scan duplicates. Only hash-confirmed groups will appear here." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar x:Name="DuplicateActivityProgressBar"
                                     Style="{StaticResource FullTrackActivityProgressBarStyle}"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="DUPLICATE OPERATION STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Row="3"
                                   Margin="45,7,0,0"
                                   Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  Height="{Binding ViewportHeight, ElementName=ToolContentScrollViewer, Converter={StaticResource SubtractDoubleConverter}, ConverterParameter=34}"
                  DataContext="{Binding StartupManager}"
                  Visibility="{Binding DataContext.IsStartupManagerContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModuleHeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentSoftBrush}" Style="{StaticResource ModuleHeroIconStyle}"><TextBlock Text="&#xE768;" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource ModuleHeroGlyphStyle}" /></Border>
                        <StackPanel Grid.Column="1" Margin="16,0,22,0" VerticalAlignment="Center">
                            <TextBlock Text="Startup inventory" Style="{StaticResource ModuleHeroTitleStyle}" />
                            <TextBlock Text="Review supported Windows startup entries and safely enable or disable one item at a time. Original commands and files are never deleted." Style="{StaticResource ModuleHeroDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ScanCommand}" Style="{StaticResource FluentPrimaryButtonStyle}" Margin="0,0,8,0" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Scan startup items" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Command="{Binding CancelCommand}" Style="{StaticResource FluentSecondaryButtonStyle}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Cancel" VerticalAlignment="Center" /></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="16,14" Style="{StaticResource FluentCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="&#xE8A5;" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="STARTUP ITEMS" Style="{StaticResource FluentCaptionStyle}" /><TextBlock Text="{Binding ItemsFound}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /></StackPanel></Grid></Border>
                    <Border Grid.Column="2" Padding="16,14" Style="{StaticResource FluentCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource SuccessSoftBrush}"><TextBlock Text="&#xE73E;" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="ENABLED" Style="{StaticResource FluentCaptionStyle}" /><TextBlock Text="{Binding EnabledItems}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /></StackPanel></Grid></Border>
                    <Border Grid.Column="4" Padding="16,14" Style="{StaticResource FluentCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource DangerSoftBrush}"><TextBlock Text="&#xE711;" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="DISABLED" Style="{StaticResource FluentCaptionStyle}" /><TextBlock Text="{Binding DisabledItems}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /></StackPanel></Grid></Border>
                    <Border Grid.Column="6" Padding="16,14" Style="{StaticResource FluentCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource WarningSoftBrush}"><TextBlock Text="&#xE897;" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="UNKNOWN" Style="{StaticResource FluentCaptionStyle}" /><TextBlock Text="{Binding UnknownItems}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /></StackPanel></Grid></Border>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="14,10"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CLICK A STATUS TO CHANGE THAT ITEM"
                                               Style="{StaticResource FluentCaptionStyle}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Green Enabled and red Disabled controls act on their own row only. Every change asks for confirmation and preserves the original command or file."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Margin="18,0,0,0"
                                        Padding="10,6"
                                        Background="{DynamicResource WarningSoftBrush}"
                                        CornerRadius="12"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0"
                                                   Text="Administrator permission active"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                              x:Name="StartupItemsGrid"
                              Style="{StaticResource FluentDataGridStyle}"
                              ItemsSource="{Binding Results}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Background="{DynamicResource SurfaceBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME"
                                                Binding="{Binding Name}"
                                                HeaderStyle="{StaticResource StartupNameHeaderStyle}"
                                                ElementStyle="{StaticResource StartupNameCellTextStyle}"
                                                IsReadOnly="True"
                                                Width="1.35*"
                                                MinWidth="160" />
                            <DataGridTextColumn Header="COMMAND / PATH"
                                                Binding="{Binding Command}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="2.4*"
                                                MinWidth="150" />
                            <DataGridTextColumn Header="SOURCE"
                                                Binding="{Binding Source}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="1.5*"
                                                MinWidth="110" />
                            <DataGridTextColumn Header="LOCATION"
                                                Binding="{Binding Location}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="2*"
                                                MinWidth="140" />
                            <DataGridTemplateColumn Header="STATUS"
                                                    IsReadOnly="True"
                                                    Width="1.25*"
                                                    MinWidth="122">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleItemStateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StartupStateButtonStyle}"
                                                ToolTip="{Binding StateActionToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StateGlyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0"
                                                           Text="{Binding StateLabel}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                        <Border Grid.Row="1"
                                Background="{DynamicResource SurfaceBrush}"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=StartupItemsGrid, Path=HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                <Border Width="58" Height="58" Background="{DynamicResource AccentSoftBrush}" CornerRadius="18" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="0,14,0,0" Text="No startup items listed yet" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,5,0,0" Text="Run Scan startup items, then click an Enabled or Disabled status in the table. Original entries are never deleted." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE768;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="STARTUP MANAGER STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Margin="45,7,0,0"
                                   Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

<Grid Grid.Row="1"
      Margin="20,14,20,16"
      Height="{Binding ViewportHeight, ElementName=ToolContentScrollViewer, Converter={StaticResource SubtractDoubleConverter}, ConverterParameter=30}"
      DataContext="{Binding WindowsRepairAssessment}"
      Visibility="{Binding DataContext.IsWindowsRepairAssessmentContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource ModuleHeroCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource AccentSoftBrush}"
                    Style="{StaticResource ModuleHeroIconStyle}">
                <TextBlock Text="&#xE90F;"
                           Foreground="{DynamicResource AccentBrush}"
                           Style="{StaticResource ModuleHeroGlyphStyle}" />
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="Windows Assessment and Guided Repair"
                           Style="{StaticResource ModuleHeroTitleStyle}"
                           FontSize="23" />
                <TextBlock Margin="0,4,0,0"
                           Text="Check Windows for system file problems and run a safe guided repair only when an issue is found."
                           Style="{StaticResource ModuleHeroDescriptionStyle}" />
            </StackPanel>

            <WrapPanel Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="0,14,0,0"
                       HorizontalAlignment="Right">
                <Button Command="{Binding RunAssessmentCommand}"
                        Style="{StaticResource FluentPrimaryButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource ActionButtonGlyphStyle}" />
                        <TextBlock Margin="8,0,0,0"
                                   Text="Run assessment"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PreviewRepairPlanCommand}"
                        Style="{StaticResource FluentSecondaryButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource ActionButtonGlyphStyle}" />
                        <TextBlock Margin="8,0,0,0"
                                   Text="Review and repair"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopAfterCurrentCheckCommand}"
                        Style="{StaticResource FluentSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource ActionButtonGlyphStyle}" />
                        <TextBlock Margin="8,0,0,0"
                                   Text="Stop after current step"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.9*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="0.85*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="0.95*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.15*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="16,12"
                MinHeight="98"
                Style="{StaticResource FluentCardStyle}">
            <StackPanel>
                <TextBlock Text="ASSESSMENT CHECKS"
                           Style="{StaticResource FluentCaptionStyle}" />

                <CheckBox Margin="0,9,0,0"
                          IsChecked="{Binding CheckComponentStore, Mode=TwoWay}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VerticalContentAlignment="Center">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="DISM CheckHealth"
                                   FontSize="12.5"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="Windows component store"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10.5" />
                    </StackPanel>
                </CheckBox>

                <CheckBox Margin="0,8,0,0"
                          IsChecked="{Binding VerifyProtectedSystemFiles, Mode=TwoWay}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VerticalContentAlignment="Center">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="SFC VerifyOnly"
                                   FontSize="12.5"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="Protected Windows files"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10.5" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Padding="16,12"
                MinHeight="98"
                Style="{StaticResource FluentCardStyle}">
            <StackPanel>
                <TextBlock Text="COMPLETED"
                           Style="{StaticResource FluentCaptionStyle}" />
                <TextBlock Margin="0,7,0,0"
                           Text="{Binding CompletedChecks}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,1,0,0"
                           Text="checks"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10.5" />
            </StackPanel>
        </Border>

        <Border Grid.Column="4"
                Padding="16,12"
                MinHeight="98"
                Style="{StaticResource FluentCardStyle}">
            <StackPanel>
                <TextBlock Text="NO ISSUE"
                           Style="{StaticResource FluentCaptionStyle}" />
                <TextBlock Margin="0,7,0,0"
                           Text="{Binding HealthyChecks}"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,1,0,0"
                           Text="classified"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10.5" />
            </StackPanel>
        </Border>

        <Border Grid.Column="6"
                Padding="16,12"
                MinHeight="98"
                Style="{StaticResource FluentCardStyle}">
            <StackPanel>
                <TextBlock Text="REVIEW"
                           Style="{StaticResource FluentCaptionStyle}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding AttentionChecks}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="Attention"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="8,0" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding InconclusiveChecks}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="Inconclusive"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.88*" MinWidth="236" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="2.45*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="18"
                Style="{StaticResource FluentElevatedCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="ASSESSMENT SAFEGUARDS"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10"
                           FontWeight="Bold" />

                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                    <TextBlock Text="Assessment first, repair only with consent"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Text="Assessment stays read-only. Guided repair requires eligible evidence, fresh checks, and explicit confirmation."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24"
                                Height="24"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="8">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="Assessment uses Microsoft read-only commands"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24"
                                Height="24"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="8">
                            <TextBlock Text="&#xE71A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="Active Microsoft repair or check is never force-closed"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24"
                                Height="24"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="8">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="Reports remain local and sanitized"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Padding="11,9"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Safe stop"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Finishes the active Microsoft step normally, then skips only steps that have not started."
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock Text="LATEST REFERENCE"
                               Style="{StaticResource FluentCaptionStyle}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding LatestReference}"
                               ToolTip="{Binding LatestReference}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding ExportLatestReportCommand}"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                ToolTip="Export assessment report">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDE1;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                <TextBlock Margin="7,0,0,0" Text="Export" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding OpenAssessmentFolderCommand}"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                ToolTip="Open assessment folder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                <TextBlock Margin="7,0,0,0" Text="Folder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource FluentElevatedCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="18,15,18,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="ASSESSMENT RESULTS"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="Results are classified conservatively; unknown wording remains Inconclusive."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource OperationMetaChipStyle}">
                        <TextBlock Text="{Binding AssessmentState}"
                                   Foreground="{DynamicResource MetaTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="12,0,12,12">
                    <DataGrid x:Name="WindowsRepairResultsGrid"
                              ItemsSource="{Binding Results}"
                              Style="{StaticResource FluentDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CHECK"
                                                Binding="{Binding Title}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                Width="1.15*"
                                                MinWidth="125" />
                            <DataGridTextColumn Header="RESULT"
                                                Binding="{Binding OutcomeText}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                Width="112"
                                                MinWidth="100" />
                            <DataGridTextColumn Header="DURATION"
                                                Binding="{Binding DurationText}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                Width="80"
                                                MinWidth="72" />
                            <DataGridTextColumn Header="SUMMARY"
                                                Binding="{Binding Summary}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                Width="1.75*"
                                                MinWidth="155" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=WindowsRepairResultsGrid, Path=HasItems}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="410">
                            <Border Width="54"
                                    Height="54"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="17">
                                <TextBlock Text="&#xE90F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="21"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="0,13,0,0"
                                       Text="No assessment results yet"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="Choose one or both approved checks, then run the read-only assessment."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <Border Grid.Row="3"
            Margin="0,12,0,0"
            Padding="16,13"
            Style="{StaticResource FluentElevatedCardStyle}"
            Visibility="{Binding HasLatestRepairResult, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            Background="{DynamicResource SuccessSoftBrush}"
                            CornerRadius="10">
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LATEST GUIDED-REPAIR RESULT"
                                   Style="{StaticResource FluentCaptionStyle}" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding RepairResultOutcome}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RepairResultReference}"
                               ToolTip="{Binding RepairResultReference}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding RepairResultCompletedText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10.5"
                               HorizontalAlignment="Right" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding RepairResultDurationText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10.5"
                               HorizontalAlignment="Right" />
                    <Button Margin="0,7,0,0"
                            Command="{Binding ExportLatestRepairResultCommand}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
