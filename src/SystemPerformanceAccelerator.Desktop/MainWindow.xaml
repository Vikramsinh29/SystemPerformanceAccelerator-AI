                                 Margin="-4,-4,-4,9"
                                 Columns="4">
                        <Border Style="{StaticResource ResponsiveSummaryCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OVERALL" Style="{StaticResource ResponsiveSummaryCardCaptionStyle}" />
                                    <TextBlock Text="{Binding OverallStatusText}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Current health state"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="34"
                                        Height="34"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="10">
                                    <TextBlock Text="&#xE9D9;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ResponsiveSummaryCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GOOD" Style="{StaticResource ResponsiveSummaryCardCaptionStyle}" />
                                    <TextBlock Text="{Binding GoodCount}" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource SummaryMetricValueStyle}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="No attention required"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="34"
                                        Height="34"
                                        Background="{DynamicResource SuccessSoftBrush}"
                                        CornerRadius="10">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ResponsiveSummaryCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ATTENTION" Style="{StaticResource ResponsiveSummaryCardCaptionStyle}" />
                                    <TextBlock Text="{Binding AttentionCount}" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource SummaryMetricValueStyle}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Review recommended"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="34"
                                        Height="34"
                                        Background="{DynamicResource WarningSoftBrush}"
                                        CornerRadius="10">
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ResponsiveSummaryCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="UNKNOWN" Style="{StaticResource ResponsiveSummaryCardCaptionStyle}" />
                                    <TextBlock Text="{Binding UnknownCount}" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Not available"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="34"
                                        Height="34"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        CornerRadius="10">
                                    <TextBlock Text="&#xE897;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2"
                            Style="{StaticResource FluentElevatedCardStyle}"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="18,14"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Health findings"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Review each current condition, then open only the recommendation you want to inspect."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Margin="16,0,0,0"
                                            Style="{StaticResource HeaderStatusBadgeStyle}"
                                            ToolTip="{Binding FindingsHeaderStatus}">
                                        <TextBlock Text="{Binding FindingsHeaderStatus}"
                                                   Style="{StaticResource HeaderStatusBadgeTextStyle}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <DataGrid x:Name="HealthFindingsGrid"
                                          ItemsSource="{Binding Results}"
                                          behaviors:DataGridSelectionBehavior.IsEnabled="False"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          RowHeaderWidth="0"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          Background="{DynamicResource SurfaceBrush}"
                                          Style="{StaticResource FluentDataGridStyle}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CHECK"
                                                            Binding="{Binding Name, Mode=OneWay}"
                                                            ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                            IsReadOnly="True"
                                                            Width="1.25*" />
                                        <DataGridTextColumn Header="STATUS"
                                                            Binding="{Binding StatusText, Mode=OneWay}"
                                                            ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                            IsReadOnly="True"
                                                            Width="0.8*" />
                                        <DataGridTextColumn Header="VALUE"
                                                            Binding="{Binding Value, Mode=OneWay}"
                                                            ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                            IsReadOnly="True"
                                                            Width="1.25*" />
                                        <DataGridTextColumn Header="DETAILS"
                                                            Binding="{Binding Details, Mode=OneWay}"
                                                            ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                            IsReadOnly="True"
                                                            Width="2.8*" />
                                        <DataGridTemplateColumn Header="RECOMMENDATION"
                                                                Width="176"
                                                                MinWidth="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding ViewRecommendationCommand}"
                                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                                            Height="30"
                                                            MinWidth="148"
                                                            Padding="10,0"
                                                            Margin="6,2"
                                                            HorizontalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8A7;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Margin="7,0,0,0"
                                                                       Text="View recommendation"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=HealthFindingsGrid, Path=HasItems}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                MaxWidth="430">
                                        <Border Width="58"
                                                Height="58"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="18">
                                            <TextBlock Text="&#xE9D9;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Margin="0,14,0,0"
                                                   Text="No health findings yet"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="Run a read-only health check to review storage, processor, memory, and startup conditions."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Style="{StaticResource OperationStatusPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         IsIndeterminate="{Binding IsBusy}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ProgressTrackBrush}" />

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource OperationStatusIconStyle}">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource OperationStatusGlyphStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                    <TextBlock Text="HEALTH CHECK STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding Status}"
                                               ToolTip="{Binding Status}"
                                               Style="{StaticResource OperationStatusMessageStyle}" />
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                    <TextBlock Text="{Binding CheckState}"
                                               Foreground="{DynamicResource MetaTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="48,7,0,0" Orientation="Horizontal">
                                <TextBlock Text="{Binding LastChecked, StringFormat='Checked: {0}'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,0,16,0" />
                                <TextBlock Text="{Binding WarningText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource FluentElevatedCardStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedRecommendation}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="18,14"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Command="{Binding BackToFindingsCommand}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                        Height="34"
                                        MinWidth="180"
                                        Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Text="Back to health findings"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedFinding.Name}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding SelectedFinding.Recommendation.Title}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="3"
                                        Margin="16,0,0,0"
                                        Padding="12,6"
                                        Background="{DynamicResource WarningSoftBrush}"
                                        CornerRadius="12"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Priority: "
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding SelectedFinding.Recommendation.PriorityText}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.7*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="15,13">
                                        <StackPanel>
                                            <TextBlock Text="CURRENT STATUS" Style="{StaticResource FluentCaptionStyle}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.StatusText}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="15,13">
                                        <StackPanel>
                                            <TextBlock Text="CURRENT VALUE" Style="{StaticResource FluentCaptionStyle}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Value}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource FluentCardStyle}" Padding="15,13">
                                        <StackPanel>
                                            <TextBlock Text="WHAT WAS DETECTED" Style="{StaticResource FluentCaptionStyle}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Details}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource FluentElevatedCardStyle}" Padding="17,15">
                                        <StackPanel>
                                            <Border Width="38"
                                                    Height="38"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="11">
                                                <TextBlock Text="&#xE8A7;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Margin="0,12,0,0"
                                                       Text="Recommended change"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Recommendation.Recommendation}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource FluentElevatedCardStyle}" Padding="17,15">
                                        <StackPanel>
                                            <Border Width="38"
                                                    Height="38"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource SuccessSoftBrush}"
                                                    CornerRadius="11">
                                                <TextBlock Text="&#xE946;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Margin="0,12,0,0"
                                                       Text="Why it matters"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Recommendation.WhyItMatters}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Padding="17,15"
                                            Background="{DynamicResource WarningSoftBrush}"
                                            BorderBrush="{DynamicResource WarningBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Margin="8,0,0,0"
                                                           Text="Warning and safety"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{Binding SelectedFinding.SafetyNotice}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource FluentCardStyle}"
                                            Padding="17,15">
                                        <StackPanel>
                                            <TextBlock Text="AVAILABLE ACTION" Style="{StaticResource FluentCaptionStyle}" />
                                            <TextBlock Margin="0,7,0,0"
                                                       Text="{Binding SelectedFinding.AvailableAction}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />

                                            <WrapPanel Margin="0,13,0,0">
                                                <WrapPanel.Style>
                                                    <Style TargetType="WrapPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedFinding.ShowDiskActions}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </WrapPanel.Style>
                                                <Button Command="{Binding SelectedFinding.OpenCleanerCommand}"
                                                        Style="{StaticResource FluentPrimaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Content="Open Cleaner" />
                                                <Button Command="{Binding SelectedFinding.OpenLargeFileFinderCommand}"
                                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Content="Open Large File Finder" />
                                                <Button Command="{Binding SelectedFinding.OpenDuplicateFileFinderCommand}"
                                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Content="Open Duplicate Finder" />
                                            </WrapPanel>

                                            <Button Command="{Binding SelectedFinding.OpenSystemMonitorCommand}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,13,0,0"
                                                    Content="Open System Monitor">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FluentPrimaryButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedFinding.ShowSystemMonitorAction}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Command="{Binding SelectedFinding.OpenStartupManagerCommand}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,13,0,0"
                                                    Content="Open Startup Manager">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FluentPrimaryButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedFinding.ShowStartupManagerAction}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2"
                                Padding="17,12"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock Margin="9,0,0,0"
                                           Text="Health Check never applies changes directly. Each action opens the relevant safety-controlled tool for review and explicit confirmation."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  Height="{Binding ViewportHeight, ElementName=ToolContentScrollViewer, Converter={StaticResource SubtractDoubleConverter}, ConverterParameter=34}"
                  Visibility="{Binding IsCleanerContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,14"
                        Padding="22,18"
                        Style="{StaticResource FluentElevatedCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="52"
                                Height="52"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="16"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,22,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Temporary file cleanup"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="Review current-user Windows temporary files, select only what you want removed, and keep every cleanup under explicit confirmation."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Left"
                                       MaxWidth="570" />

                            <Border Margin="0,10,0,0"
                                    Padding="9,5"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SuccessSoftBrush}"
                                    CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;"
