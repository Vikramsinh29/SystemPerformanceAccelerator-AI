<Window x:Class="SystemPerformanceAccelerator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SystemPerformanceAccelerator.Desktop.Behaviors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="System Performance Accelerator"
        Width="1240"
        Height="780"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Style="{StaticResource FluentWindowStyle}"
        Background="{DynamicResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FluentNavigationButtonStyle}" />

        <Style x:Key="FeatureAccessBadgeStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentBadgeStyle}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FluentPrimaryButtonStyle}" />

        <Style x:Key="CleanButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FluentPrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="MinWidth" Value="132" />
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FluentSecondaryButtonStyle}" />

        <Style x:Key="SummaryCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="Padding" Value="18,15" />
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FluentTextBoxStyle}" />

        <Style x:Key="InputComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource FluentComboBoxStyle}" />

        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeaderStyle}" />

        <Style TargetType="DataGridCell" BasedOn="{StaticResource FluentDataGridCellStyle}" />

        <Style x:Key="ResponsiveDataGridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style TargetType="DataGridRow" BasedOn="{StaticResource FluentDataGridRowStyle}" />
        <Style x:Key="OperationStatusPanelStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="MinHeight" Value="98" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="OperationStatusIconStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OperationStatusGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ScheduleMetricIconStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OperationStatusLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentCaptionStyle}" />

        <Style x:Key="OperationStatusMessageStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="OperationMetaChipStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ResultMetricCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="ResultMetricLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentCaptionStyle}">
            <Setter Property="FontSize" Value="9" />
        </Style>

        <Style x:Key="ResultMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="OperationResultSummaryTemplate">
            <StackPanel Margin="45,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ProcessedLabel}" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding ProcessedValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SKIPPED" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding SkippedValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="FAILED" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding FailedValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="RECLAIMED" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding ReclaimedValue}" Style="{StaticResource ResultMetricValueStyle}" ToolTip="{Binding ReclaimedValue}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="8" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="DURATION" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding DurationValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,7,0,0"
                        Padding="10,8"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="14" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="FIRST ISSUE" Foreground="{DynamicResource WarningBrush}" FontSize="9" FontWeight="Bold" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="{Binding Detail}"
                                       ToolTip="{Binding Detail}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       MaxHeight="34" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowRoot"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource TitleBarBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource TitleBarBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource TitleBarBrush}" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="MinimizeButton"
                                Content="&#xE921;"
                                Style="{StaticResource FluentCaptionButtonStyle}"
                                ToolTip="Minimize"
                                AutomationProperties.Name="Minimize window"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="&#xE922;"
                                Style="{StaticResource FluentCaptionButtonStyle}"
                                ToolTip="Maximize"
                                AutomationProperties.Name="Maximize or restore window"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeRestoreButton_Click" />
                        <Button x:Name="CloseButton"
                                Content="&#xE8BB;"
                                Style="{StaticResource FluentCloseCaptionButtonStyle}"
                                ToolTip="Close"
                                AutomationProperties.Name="Close window"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Height="80"
                        Padding="20,0,16,0"
                        BorderBrush="{DynamicResource SidebarDividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="{DynamicResource AccentBrush}" CornerRadius="10">
                            <TextBlock Text="SPA"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SYSTEM PERFORMANCE" Foreground="{DynamicResource SidebarTextBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="ACCELERATOR" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Margin="22,0,0,7" Text="TOOLS" Foreground="{DynamicResource SidebarMutedTextBrush}" FontSize="10" FontWeight="Bold" />

                    <Button Command="{Binding ShowCleanerCommand}"
                            Visibility="{Binding CleanerAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding CleanerAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCleanerActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Cleaner" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding CleanerAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding CleanerAccess.Message}">
                                <TextBlock Text="{Binding CleanerAccess.BadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowHealthCheckCommand}"
                            Visibility="{Binding HealthCheckAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding HealthCheckAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHealthCheckActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Health Check" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding HealthCheckAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding HealthCheckAccess.Message}">
                                <TextBlock Text="{Binding HealthCheckAccess.BadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowCustomCleanCommand}"
                            Visibility="{Binding CustomCleanAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding CustomCleanAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomCleanActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Custom Clean" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding CustomCleanAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding CustomCleanAccess.Message}">
                                <TextBlock Text="{Binding CustomCleanAccess.BadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowAutoCleanScheduleCommand}"
                            Visibility="{Binding AutoCleanScheduleAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding AutoCleanScheduleAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoCleanScheduleActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Auto Clean Schedule" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding AutoCleanScheduleAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding AutoCleanScheduleAccess.Message}">
                                <TextBlock Text="{Binding AutoCleanScheduleAccess.BadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowLargeFileFinderCommand}"
                            Visibility="{Binding LargeFileFinderAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding LargeFileFinderAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLargeFileFinderActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Large File Finder" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding LargeFileFinderAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding LargeFileFinderAccess.Message}">
                                <TextBlock Text="{Binding LargeFileFinderAccess.BadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowDuplicateFileFinderCommand}"
                            Visibility="{Binding DuplicateFileFinderAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding DuplicateFileFinderAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDuplicateFileFinderActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Duplicate Finder" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding DuplicateFileFinderAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding DuplicateFileFinderAccess.Message}">
                                <TextBlock Text="{Binding DuplicateFileFinderAccess.BadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowStartupManagerCommand}"
                            Visibility="{Binding StartupManagerAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding StartupManagerAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStartupManagerActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Startup Manager" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding StartupManagerAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding StartupManagerAccess.Message}">
                                <TextBlock Text="{Binding StartupManagerAccess.BadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowSystemMonitorCommand}"
                            Visibility="{Binding SystemMonitorAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding SystemMonitorAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemMonitorActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="System Monitor" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding SystemMonitorAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding SystemMonitorAccess.Message}">
                                <TextBlock Text="{Binding SystemMonitorAccess.BadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowSettingsCommand}"
                            Visibility="{Binding SettingsAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding SettingsAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding SettingsAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding SettingsAccess.Message}">
                                <TextBlock Text="{Binding SettingsAccess.BadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Margin="14,12,14,16" Padding="14" Background="{DynamicResource SidebarPanelBrush}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="OFFLINE &amp; SAFE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="No cloud services. Review every file before cleanup."
                                   Foreground="{DynamicResource SidebarMutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModuleTitle}"
                                   ToolTip="{Binding ModuleTitle}"
                                   Style="{StaticResource FluentPageTitleStyle}" />
                        <TextBlock Text="{Binding ModuleSubtitle}"
                                   ToolTip="{Binding ModuleSubtitle}"
                                   Style="{StaticResource FluentPageSubtitleStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Windows 10/11" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding EditionStatusText}"
                                   ToolTip="{Binding EditionStatusText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="24,20,24,22"
                    Padding="36"
                    Style="{StaticResource FluentElevatedCardStyle}"
                    Visibility="{Binding IsLockedFeatureActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="38"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,14,0,0"
                               Text="{Binding ModuleTitle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding CurrentFeatureAccess.Message}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding EditionStatusText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding HealthCheck}"
                  Visibility="{Binding DataContext.IsHealthCheckContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedRecommendation}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,14"
                            Padding="22,18"
                            Style="{StaticResource FluentElevatedCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="52"
                                    Height="52"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="16"
                                    VerticalAlignment="Top">
                                <TextBlock Text="&#xE9D9;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="21"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="16,0,22,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="System health review"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Review storage, CPU, memory, and startup conditions without changing Windows. Findings remain separate from recommendations until you choose one."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxWidth="620" />

                                <Border Margin="0,10,0,0"
                                        Padding="9,5"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource SuccessSoftBrush}"
                                        CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0"
                                                   Text="Read-only • user-requested recommendations"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Width="286"
                                        VerticalAlignment="Center">
                                <Button Command="{Binding RunCheckCommand}"
                                        Style="{StaticResource FluentPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Text="Run health check"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Margin="0,8,0,0"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Text="Cancel current check"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="18,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OVERALL" Style="{StaticResource FluentCaptionStyle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding OverallStatusText}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="23"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Current health state"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10.5" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="12">
                                    <TextBlock Text="&#xE9D9;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="18,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GOOD" Style="{StaticResource FluentCaptionStyle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding GoodCount}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontSize="23"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="No attention required"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10.5" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        Background="{DynamicResource SuccessSoftBrush}"
                                        CornerRadius="12">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource FluentCardStyle}" Padding="18,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ATTENTION" Style="{StaticResource FluentCaptionStyle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding AttentionCount}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="23"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Review recommended"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10.5" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        Background="{DynamicResource WarningSoftBrush}"
                                        CornerRadius="12">
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource FluentCardStyle}" Padding="18,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="UNKNOWN" Style="{StaticResource FluentCaptionStyle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding UnknownCount}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="23"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Not available"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10.5" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        CornerRadius="12">
                                    <TextBlock Text="&#xE897;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Style="{StaticResource FluentElevatedCardStyle}"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="18,14"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Health findings"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Review each current condition, then open only the recommendation you want to inspect."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="10,5"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="12"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Findings first"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <DataGrid x:Name="HealthFindingsGrid"
                                          ItemsSource="{Binding Results}"
                                          behaviors:DataGridSelectionBehavior.IsEnabled="False"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          BorderThickness="0"
                                          RowHeaderWidth="0"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          Background="{DynamicResource SurfaceBrush}"
                                          Style="{StaticResource FluentDataGridStyle}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CHECK"
                                                            Binding="{Binding Name, Mode=OneWay}"
                                                            ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                            IsReadOnly="True"
                                                            Width="1.25*" />
                                        <DataGridTextColumn Header="STATUS"
                                                            Binding="{Binding StatusText, Mode=OneWay}"
                                                            ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                            IsReadOnly="True"
                                                            Width="0.8*" />
                                        <DataGridTextColumn Header="VALUE"
                                                            Binding="{Binding Value, Mode=OneWay}"
                                                            ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                            IsReadOnly="True"
                                                            Width="1.25*" />
                                        <DataGridTextColumn Header="DETAILS"
                                                            Binding="{Binding Details, Mode=OneWay}"
                                                            ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                            IsReadOnly="True"
                                                            Width="2.8*" />
                                        <DataGridTemplateColumn Header="RECOMMENDATION"
                                                                Width="176"
                                                                MinWidth="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding ViewRecommendationCommand}"
                                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                                            Height="30"
                                                            MinWidth="148"
                                                            Padding="10,0"
                                                            Margin="6,2"
                                                            HorizontalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8A7;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Margin="7,0,0,0"
                                                                       Text="View recommendation"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=HealthFindingsGrid, Path=HasItems}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                MaxWidth="430">
                                        <Border Width="58"
                                                Height="58"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="18">
                                            <TextBlock Text="&#xE9D9;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Margin="0,14,0,0"
                                                   Text="No health findings yet"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="Run a read-only health check to review storage, processor, memory, and startup conditions."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Style="{StaticResource OperationStatusPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         IsIndeterminate="{Binding IsBusy}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ProgressTrackBrush}" />

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource OperationStatusIconStyle}">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource OperationStatusGlyphStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                    <TextBlock Text="HEALTH CHECK STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding Status}"
                                               ToolTip="{Binding Status}"
                                               Style="{StaticResource OperationStatusMessageStyle}" />
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                    <TextBlock Text="{Binding CheckState}"
                                               Foreground="{DynamicResource MetaTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="48,7,0,0" Orientation="Horizontal">
                                <TextBlock Text="{Binding LastChecked, StringFormat='Checked: {0}'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,0,16,0" />
                                <TextBlock Text="{Binding WarningText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource FluentElevatedCardStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedRecommendation}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="18,14"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Command="{Binding BackToFindingsCommand}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                        Height="34"
                                        MinWidth="180"
                                        Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Text="Back to health findings"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedFinding.Name}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding SelectedFinding.Recommendation.Title}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="3"
                                        Margin="16,0,0,0"
                                        Padding="12,6"
                                        Background="{DynamicResource WarningSoftBrush}"
                                        CornerRadius="12"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Priority: "
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding SelectedFinding.Recommendation.PriorityText}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.7*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="15,13">
                                        <StackPanel>
                                            <TextBlock Text="CURRENT STATUS" Style="{StaticResource FluentCaptionStyle}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.StatusText}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="15,13">
                                        <StackPanel>
                                            <TextBlock Text="CURRENT VALUE" Style="{StaticResource FluentCaptionStyle}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Value}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource FluentCardStyle}" Padding="15,13">
                                        <StackPanel>
                                            <TextBlock Text="WHAT WAS DETECTED" Style="{StaticResource FluentCaptionStyle}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Details}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource FluentElevatedCardStyle}" Padding="17,15">
                                        <StackPanel>
                                            <Border Width="38"
                                                    Height="38"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="11">
                                                <TextBlock Text="&#xE8A7;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Margin="0,12,0,0"
                                                       Text="Recommended change"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Recommendation.Recommendation}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource FluentElevatedCardStyle}" Padding="17,15">
                                        <StackPanel>
                                            <Border Width="38"
                                                    Height="38"
