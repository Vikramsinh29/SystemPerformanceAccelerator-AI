<Window x:Class="SystemPerformanceAccelerator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SystemPerformanceAccelerator.Desktop.Behaviors"
        xmlns:controls="clr-namespace:SystemPerformanceAccelerator.Desktop.Controls"
        xmlns:models="clr-namespace:SystemPerformanceAccelerator.Core.Models;assembly=SystemPerformanceAccelerator.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PC-SPA — System Performance Accelerator"
        Width="1240"
        Height="780"
        MinWidth="1000"
        MinHeight="650"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Style="{StaticResource FluentWindowStyle}"
        Background="{DynamicResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo ProgressState="{Binding WindowsRepairAssessment.TaskbarProgressState}" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FluentNavigationButtonStyle}" />

        <Style x:Key="FeatureAccessBadgeStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentBadgeStyle}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FluentPrimaryButtonStyle}" />

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FluentSecondaryButtonStyle}" />

        <Style x:Key="SummaryCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="Padding" Value="18,15" />
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FluentTextBoxStyle}" />

        <Style x:Key="InputPasswordBoxStyle"
               TargetType="PasswordBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1.2" />
            <Setter Property="Padding"
                    Value="14,11" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource FluentComboBoxStyle}" />

        <Style x:Key="BulkSelectionHeaderCheckBoxStyle"
               TargetType="CheckBox">
            <Setter Property="IsThreeState" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Select all or deselect all displayed files" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HeaderCheckBorder"
                                    Width="18"
                                    Height="18"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="HeaderCheckGlyph"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <TextBlock x:Name="HeaderIndeterminateGlyph"
                                               Text="&#x2212;"
                                               FontFamily="Segoe UI"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="7,0,0,0"
                                       Text="ALL"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderCheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="HeaderCheckBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="HeaderCheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="HeaderCheckGlyph"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="HeaderCheckBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="HeaderCheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="HeaderIndeterminateGlyph"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderCheckBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="HeaderCheckBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeaderStyle}" />

        <Style TargetType="DataGridCell" BasedOn="{StaticResource FluentDataGridCellStyle}" />

        <Style x:Key="ResponsiveDataGridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style TargetType="DataGridRow" BasedOn="{StaticResource FluentDataGridRowStyle}" />

        <Style x:Key="StartupStateButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StateBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="StateBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="StateBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="StateBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="StateBorder" Property="Opacity" Value="0.56" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:StartupItemState.Enabled}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:StartupItemState.Disabled}">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OperationStatusPanelStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="MinHeight" Value="98" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="OperationStatusIconStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OperationStatusGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModuleHeroCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentElevatedCardStyle}">
            <Setter Property="Padding" Value="22,18" />
        </Style>

        <Style x:Key="ModuleHeroIconStyle" TargetType="Border">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="ModuleHeroGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModuleHeroTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ModuleHeroDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SummaryMetricIconStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummaryMetricGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummaryMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ResponsiveSummaryCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="96" />
        </Style>

        <Style x:Key="ResponsiveSummaryCardCaptionStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentCaptionStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <Style x:Key="SummaryMetricCompactValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ActionButtonGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OperationStatusLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentCaptionStyle}" />

        <Style x:Key="OperationStatusMessageStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="OperationMetaChipStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HeaderStatusBadgeStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentBadgeStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HeaderStatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CompletionStatusChipStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentBadgeStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxWidth" Value="280" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CompletionStatusChipTextStyle" TargetType="TextBlock">
            <Setter Property="MaxWidth" Value="254" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StartupNameHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource FluentDataGridColumnHeaderStyle}">
            <Setter Property="Padding" Value="20,0,12,0" />
        </Style>

        <Style x:Key="StartupNameCellTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource ResponsiveDataGridTextStyle}">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="ResultMetricCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentCardStyle}">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="ResultMetricLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FluentCaptionStyle}">
            <Setter Property="FontSize" Value="9" />
        </Style>

        <Style x:Key="ResultMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="OperationResultSummaryTemplate">
            <StackPanel Margin="45,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ProcessedLabel}" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding ProcessedValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SKIPPED" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding SkippedValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="FAILED" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding FailedValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="RECLAIMED" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding ReclaimedValue}" Style="{StaticResource ResultMetricValueStyle}" ToolTip="{Binding ReclaimedValue}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="8" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="DURATION" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding DurationValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,7,0,0"
                        Padding="10,8"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="14" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="FIRST ISSUE" Foreground="{DynamicResource WarningBrush}" FontSize="9" FontWeight="Bold" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="{Binding Detail}"
                                       ToolTip="{Binding Detail}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       MaxHeight="34" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowRoot"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource TitleBarBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource TitleBarBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="14,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Image Width="28"
                               Height="28"
                               Source="{DynamicResource BrandPhoenixSource}"
                               Style="{StaticResource BrandImageStyle}" />
                        <Image Width="70"
                               Height="28"
                               Margin="8,0,0,0"
                               Source="{DynamicResource BrandWordmarkSource}"
                               Style="{StaticResource BrandImageStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="MinimizeButton"
                                Content="&#xE921;"
                                Style="{StaticResource FluentCaptionButtonStyle}"
                                ToolTip="Minimize"
                                AutomationProperties.Name="Minimize window"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="&#xE922;"
                                Style="{StaticResource FluentCaptionButtonStyle}"
                                ToolTip="Maximize"
                                AutomationProperties.Name="Maximize or restore window"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaximizeRestoreButton_Click" />
                        <Button x:Name="CloseButton"
                                Content="&#xE8BB;"
                                Style="{StaticResource FluentCloseCaptionButtonStyle}"
                                ToolTip="Close"
                                AutomationProperties.Name="Close window"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Height="112"
                        Padding="10,6"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource SidebarDividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ToolTip="PC-SPA — System Performance Accelerator">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Width="96"
                               Height="96"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Source="{DynamicResource BrandPhoenixSource}"
                               Style="{StaticResource BrandImageStyle}" />

                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    TextOptions.TextFormattingMode="Display"
                                    TextOptions.TextRenderingMode="ClearType">
                            <Image Width="116"
                                   Height="28"
                                   Margin="0,0,0,3"
                                   HorizontalAlignment="Left"
                                   Source="{DynamicResource BrandWordmarkSource}"
