                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="10,8" Style="{StaticResource FluentCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DISM RESTOREHEALTH" Style="{StaticResource FluentCaptionStyle}" FontSize="9.5" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding DismRestoreHealthResult}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="10,8" Style="{StaticResource FluentCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SFC SCANNOW" Style="{StaticResource FluentCaptionStyle}" FontSize="9.5" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding SfcScannowResult}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Padding="10,8" Style="{StaticResource FluentCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DISM CHECKHEALTH" Style="{StaticResource FluentCaptionStyle}" FontSize="9.5" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding DismCheckHealthResult}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Padding="10,8" Style="{StaticResource FluentCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SFC VERIFYONLY" Style="{StaticResource FluentCaptionStyle}" FontSize="9.5" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding SfcVerifyOnlyResult}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding RepairResultRecommendation}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10.5"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="2"
                           Text="{Binding AutomaticRestartEvidence}"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Border>

    <Border Grid.Row="4"
            Margin="0,12,0,0"
            Style="{StaticResource OperationStatusPanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Height="5"
                  ClipToBounds="True">
                <ProgressBar Height="5"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}"
                             IsIndeterminate="False"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource ProgressTrackBrush}" />

                <Border Background="{DynamicResource ProgressTrackBrush}"
                        CornerRadius="3"
                        Visibility="{Binding IsAssessmentRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="3">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0.5"
                                                 EndPoint="1,0.5">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform X="-0.425" />
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="Transparent"
                                              Offset="0.35" />
                                <GradientStop Color="White"
                                              Offset="0.425" />
                                <GradientStop Color="White"
                                              Offset="0.575" />
                                <GradientStop Color="Transparent"
                                              Offset="0.65" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAssessmentRunning}"
                                                 Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="WindowsRepairFullTrackActivityStoryboard">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                                     From="-0.425"
                                                                     To="0.425"
                                                                     Duration="0:0:1.8"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="WindowsRepairFullTrackActivityStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource OperationStatusIconStyle}">
                    <TextBlock Text="&#xE90F;"
                               Style="{StaticResource OperationStatusGlyphStyle}" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="12,0,18,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="WINDOWS REPAIR STATUS"
                               Style="{StaticResource OperationStatusLabelStyle}" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding CurrentCheckText}"
                               ToolTip="{Binding CurrentCheckText}"
                               Style="{StaticResource OperationStatusMessageStyle}" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding Status}"
                               ToolTip="{Binding Status}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               MaxHeight="30" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding ProgressText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10" />
                </StackPanel>

                <WrapPanel Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="46,10,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Border Style="{StaticResource OperationMetaChipStyle}"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding AssessmentState}"
                                   Foreground="{DynamicResource MetaTextBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Border Style="{StaticResource OperationMetaChipStyle}"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding ElapsedText}"
                                   Foreground="{DynamicResource MetaTextBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Button Command="{Binding OpenPastRecordsCommand}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource ActionButtonGlyphStyle}" />
                            <TextBlock Margin="7,0,0,0" Text="Past records" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteAssessmentHistoryCommand}"
                            Style="{StaticResource FluentSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource ActionButtonGlyphStyle}" />
                            <TextBlock Margin="7,0,0,0" Text="Delete history" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>

    <Grid Grid.RowSpan="5"
          Panel.ZIndex="60"
          Visibility="{Binding IsPastRecordsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Background="#B8000000" />

        <Border Margin="24"
                MaxWidth="1160"
                MaxHeight="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource FluentElevatedCardStyle}">
            <Grid Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Past Windows Repair records"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="Newest saved assessments and guided-repair results. Records are read-only."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11.5" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Margin="16,0,12,0"
                            Style="{StaticResource OperationMetaChipStyle}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding PastRecordsCountText}"
                                   Foreground="{DynamicResource MetaTextBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold" />
                    </Border>
                    <Button Grid.Column="2"
                            Command="{Binding ClosePastRecordsCommand}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Content="Back to Windows Repair"
                            VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <DataGrid x:Name="WindowsRepairPastRecordsGrid"
                              ItemsSource="{Binding PastRecords}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              Style="{StaticResource FluentDataGridStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TYPE"
                                                Binding="{Binding RecordType}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                Width="110"
                                                MinWidth="110" />
                            <DataGridTextColumn Header="REFERENCE"
                                                Binding="{Binding Reference}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                Width="220"
                                                MinWidth="220" />
                            <DataGridTextColumn Header="OUTCOME"
                                                Binding="{Binding Outcome}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                Width="150"
                                                MinWidth="150" />
                            <DataGridTextColumn Header="COMPLETED"
                                                Binding="{Binding CompletedText}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                Width="150"
                                                MinWidth="150" />
                            <DataGridTextColumn Header="DURATION"
                                                Binding="{Binding DurationText}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                Width="100"
                                                MinWidth="100" />
                            <DataGridTextColumn Header="DETAILS"
                                                Binding="{Binding Summary}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                Width="300"
                                                MinWidth="300" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=WindowsRepairPastRecordsGrid, Path=HasItems}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="No past records"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="Completed assessments and guided repairs will appear here."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <Grid Grid.RowSpan="5"
          Panel.ZIndex="50"
          Visibility="{Binding IsRepairPlanPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Background="#B8000000" />

        <Border Margin="24"
                MaxWidth="1160"
                MaxHeight="780"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource FluentElevatedCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="22,18,22,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            Background="{DynamicResource WarningSoftBrush}"
                            CornerRadius="13">
                        <TextBlock Text="&#xE9D9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{DynamicResource WarningBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,18,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Guided repair readiness preview"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Review the fixed sequence. Starting it still requires fresh checks and a separate explicit confirmation."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding CloseRepairPlanPreviewCommand}"
                            Style="{StaticResource FluentSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;"
                                       Style="{StaticResource ActionButtonGlyphStyle}" />
                            <TextBlock Margin="7,0,0,0"
                                       Text="Close preview" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Margin="22,0,22,14"
                        Padding="16,13"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding RepairPlanDecisionTitle}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding RepairPlanSummary}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="22,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding RepairPlanReference, StringFormat='Plan: {0}'}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding RepairPlanAssessmentReference, StringFormat='Assessment: {0}'}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Right" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding RepairPlanCreatedText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              Margin="22,0,22,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="16"
                                Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="READ-ONLY PREFLIGHT"
                                           Style="{StaticResource FluentCaptionStyle}"
                                           FontSize="11.5" />
                                <TextBlock Margin="0,5,0,12"
                                           Text="Every blocked or unknown safety state fails closed."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding RepairPlanPreflight}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="13,11"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="24"
                                                            Height="24"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            CornerRadius="8">
                                                        <TextBlock Text="{Binding StatusGlyph}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,10,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   Text="{Binding Detail}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11.5"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                                                            Padding="9,5"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            CornerRadius="10"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="16"
                                Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="GUIDED REPAIR SEQUENCE"
                                           Style="{StaticResource FluentCaptionStyle}"
                                           FontSize="11.5" />
                                <TextBlock Margin="0,5,0,12"
                                           Text="The sequence starts only after fresh execution-time checks and explicit confirmation."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding RepairPlanSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="13,11"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="27"
                                                            Height="27"
                                                            Background="{DynamicResource WarningSoftBrush}"
                                                            CornerRadius="9"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding SequenceText}"
                                                                   Foreground="{DynamicResource WarningBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   Text="{Binding Purpose}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11.5"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,5,0,0"
                                                                   Text="{Binding StateText}"
                                                                   Foreground="{DynamicResource WarningBrush}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding SafetyText}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="10.5"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="3"
                        Margin="22,14,22,20"
                        Padding="13,10"
                        Background="{DynamicResource DangerSoftBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource DangerBrush}"
                                   VerticalAlignment="Top" />

                        <TextBlock Grid.Column="1"
                                   Margin="9,0,18,0"
                                   Text="{Binding RepairPlanDisclosure}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="2"
                                Command="{Binding RunGuidedRepairCommand}"
