<Window x:Class="SystemPerformanceAccelerator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SystemPerformanceAccelerator.Desktop.Behaviors"
        Title="System Performance Accelerator"
        Width="1240"
        Height="780"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBrush" Color="#18212F" />
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#243145" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2583E9" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#22A765" />

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C7D0DD" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeatureAccessBadgeStyle" TargetType="Border">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="#31445F" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#AEB8C5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
            <Setter Property="MinWidth" Value="132" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryButtonForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource DataGridHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="ResponsiveDataGridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DataGridRowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource DataGridRowSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OperationStatusPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="OperationStatusLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="OperationStatusMessageStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="OperationMetaChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ResultMetricCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="ResultMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ResultMetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="OperationResultSummaryTemplate">
            <StackPanel Margin="45,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ProcessedLabel}" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding ProcessedValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SKIPPED" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding SkippedValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="FAILED" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding FailedValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="RECLAIMED" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding ReclaimedValue}" Style="{StaticResource ResultMetricValueStyle}" ToolTip="{Binding ReclaimedValue}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="8" Style="{StaticResource ResultMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="DURATION" Style="{StaticResource ResultMetricLabelStyle}" />
                            <TextBlock Text="{Binding DurationValue}" Style="{StaticResource ResultMetricValueStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,7,0,0"
                        Padding="10,8"
                        Background="#FFF8E8"
                        BorderBrush="#F0D9A4"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#B7791F" FontSize="14" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="FIRST ISSUE" Foreground="#9A681D" FontSize="9" FontWeight="Bold" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="{Binding Detail}"
                                       ToolTip="{Binding Detail}"
                                       Foreground="#6E5529"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       MaxHeight="34" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.24*" MinWidth="220" MaxWidth="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="20,20,16,18" BorderBrush="#2A3749" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="{StaticResource AccentBrush}" CornerRadius="7">
                            <TextBlock Text="SPA"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SYSTEM PERFORMANCE" Foreground="White" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="ACCELERATOR" Foreground="#9FAABC" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Margin="22,0,0,7" Text="TOOLS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />

                    <Button Command="{Binding ShowCleanerCommand}"
                            Visibility="{Binding CleanerAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding CleanerAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCleanerActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Cleaner" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding CleanerAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding CleanerAccess.Message}">
                                <TextBlock Text="{Binding CleanerAccess.BadgeText}"
                                           Foreground="White"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowHealthCheckCommand}"
                            Visibility="{Binding HealthCheckAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding HealthCheckAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHealthCheckActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Health Check" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding HealthCheckAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding HealthCheckAccess.Message}">
                                <TextBlock Text="{Binding HealthCheckAccess.BadgeText}"
                                           Foreground="White"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowCustomCleanCommand}"
                            Visibility="{Binding CustomCleanAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding CustomCleanAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomCleanActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Custom Clean" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding CustomCleanAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding CustomCleanAccess.Message}">
                                <TextBlock Text="{Binding CustomCleanAccess.BadgeText}"
                                           Foreground="White"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowAutoCleanScheduleCommand}"
                            Visibility="{Binding AutoCleanScheduleAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding AutoCleanScheduleAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoCleanScheduleActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Auto Clean Schedule" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding AutoCleanScheduleAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding AutoCleanScheduleAccess.Message}">
                                <TextBlock Text="{Binding AutoCleanScheduleAccess.BadgeText}"
                                           Foreground="White"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowLargeFileFinderCommand}"
                            Visibility="{Binding LargeFileFinderAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding LargeFileFinderAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLargeFileFinderActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Large File Finder" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding LargeFileFinderAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding LargeFileFinderAccess.Message}">
                                <TextBlock Text="{Binding LargeFileFinderAccess.BadgeText}"
                                           Foreground="White"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowDuplicateFileFinderCommand}"
                            Visibility="{Binding DuplicateFileFinderAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding DuplicateFileFinderAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDuplicateFileFinderActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Duplicate Finder" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding DuplicateFileFinderAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding DuplicateFileFinderAccess.Message}">
                                <TextBlock Text="{Binding DuplicateFileFinderAccess.BadgeText}"
                                           Foreground="White"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowStartupManagerCommand}"
                            Visibility="{Binding StartupManagerAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding StartupManagerAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStartupManagerActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Startup Manager" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding StartupManagerAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding StartupManagerAccess.Message}">
                                <TextBlock Text="{Binding StartupManagerAccess.BadgeText}"
                                           Foreground="White"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowSystemMonitorCommand}"
                            Visibility="{Binding SystemMonitorAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding SystemMonitorAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemMonitorActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="System Monitor" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding SystemMonitorAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding SystemMonitorAccess.Message}">
                                <TextBlock Text="{Binding SystemMonitorAccess.BadgeText}"
                                           Foreground="White"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowSettingsCommand}"
                            Visibility="{Binding SettingsAccess.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding SettingsAccess.Message}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource FeatureAccessBadgeStyle}"
                                    Visibility="{Binding SettingsAccess.IsBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding SettingsAccess.Message}">
                                <TextBlock Text="{Binding SettingsAccess.BadgeText}"
                                           Foreground="White"
                                           FontSize="8"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Margin="14" Padding="12" Background="#121A26" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="OFFLINE &amp; SAFE" Foreground="#83C8FF" FontSize="10" FontWeight="Bold" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="No cloud services. Review every file before cleanup."
                                   Foreground="#9FAABC"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModuleTitle}"
                                   ToolTip="{Binding ModuleTitle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ModuleSubtitle}"
                                   ToolTip="{Binding ModuleSubtitle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Windows 10/11" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding EditionStatusText}"
                                   ToolTip="{Binding EditionStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="20,16,20,18"
                    Padding="32"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsLockedFeatureActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="38"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,14,0,0"
                               Text="{Binding ModuleTitle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding CurrentFeatureAccess.Message}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding EditionStatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding HealthCheck}"
                  Visibility="{Binding DataContext.IsHealthCheckContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedRecommendation}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel>
                                <TextBlock Text="OVERALL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding OverallStatusText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel>
                                <TextBlock Text="GOOD" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding GoodCount}" Foreground="{StaticResource SuccessBrush}" FontSize="23" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ATTENTION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding AttentionCount}" Foreground="#D87924" FontSize="23" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel>
                                <TextBlock Text="UNKNOWN" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding UnknownCount}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="23" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,16,0,12" Padding="16,14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="READ-ONLY HEALTH CHECK" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Reviews system-drive free space, one current CPU/memory sample, and the existing startup inventory. Findings appear first. Open only the recommendation you want to review."
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding RunCheckCommand}" Content="Run Check" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                                <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="14,9"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TextBlock Text="HEALTH FINDINGS"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Results}"
                                      behaviors:DataGridSelectionBehavior.IsEnabled="False"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      BorderThickness="0"
                                      RowHeaderWidth="0"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      Background="{StaticResource SurfaceBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CHECK"
                                                        Binding="{Binding Name, Mode=OneWay}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="1.3*" />
                                    <DataGridTextColumn Header="STATUS"
                                                        Binding="{Binding StatusText, Mode=OneWay}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="0.9*" />
                                    <DataGridTextColumn Header="VALUE"
                                                        Binding="{Binding Value, Mode=OneWay}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="1.4*" />
                                    <DataGridTextColumn Header="DETAILS"
                                                        Binding="{Binding Details, Mode=OneWay}"
                                                        ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                        IsReadOnly="True"
                                                        Width="3.1*" />
                                    <DataGridTemplateColumn Header="RECOMMENDATION"
                                                            Width="175"
                                                            MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="View recommendations"
                                                        Command="{Binding ViewRecommendationCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Height="30"
                                                        MinWidth="145"
                                                        Padding="10,0"
                                                        Margin="6,2"
                                                        HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Style="{StaticResource OperationStatusPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ProgressBar Height="6"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         IsIndeterminate="{Binding IsBusy}"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="{StaticResource ProgressTrackBrush}" />

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="34" Height="34" Background="#E8F2FC" CornerRadius="17">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="11,0,18,0">
                                    <TextBlock Text="HEALTH CHECK STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding Status}"
                                               ToolTip="{Binding Status}"
                                               Style="{StaticResource OperationStatusMessageStyle}" />
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                    <TextBlock Text="{Binding CheckState}" Foreground="{StaticResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="45,7,0,0" Orientation="Horizontal">
                                <TextBlock Text="{Binding LastChecked, StringFormat='Checked: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedRecommendation}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="16,12"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Content="←  Back to Health Findings"
                                        Command="{Binding BackToFindingsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontFamily="Segoe UI"
                                        Height="34"
                                        MinWidth="190"
                                        Padding="12,0" />

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedFinding.Name}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding SelectedFinding.Recommendation.Title}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="3"
                                        Margin="16,0,0,0"
                                        Padding="12,6"
                                        Background="#FFF3E6"
                                        CornerRadius="12"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Priority: "
                                                   Foreground="#A65300"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding SelectedFinding.Recommendation.PriorityText}"
                                                   Foreground="#A65300"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="18">
                            <StackPanel>
                                <Border Padding="14"
                                        Background="{StaticResource SurfaceMutedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="2.2*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="CURRENT STATUS"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.StatusText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CURRENT VALUE"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Value}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="WHAT WAS DETECTED"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Details}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Padding="14"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Text="RECOMMENDED CHANGE"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Recommendation.Recommendation}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Padding="14"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Text="WHY IT MATTERS"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding SelectedFinding.Recommendation.WhyItMatters}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Margin="0,14,0,0"
                                        Padding="14"
                                        Background="#FFF7E8"
                                        BorderBrush="#E4B86B"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Text="WARNING / SAFETY"
                                                   Foreground="#8A5200"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding SelectedFinding.SafetyNotice}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0"
                                        Padding="16"
                                        Background="#EAF4FD"
                                        BorderBrush="#94BFE4"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Text="AVAILABLE ACTIONS"
                                                   Foreground="#245F91"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding SelectedFinding.AvailableAction}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />

                                        <WrapPanel Margin="0,12,0,0">
                                            <WrapPanel.Style>
                                                <Style TargetType="WrapPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedFinding.ShowDiskActions}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Style>
                                            <Button Content="Open Cleaner"
                                                    Command="{Binding SelectedFinding.OpenCleanerCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Open Large File Finder"
                                                    Command="{Binding SelectedFinding.OpenLargeFileFinderCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Open Duplicate Finder"
                                                    Command="{Binding SelectedFinding.OpenDuplicateFileFinderCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,8,8" />
                                        </WrapPanel>

                                        <Button Content="Open System Monitor"
                                                Command="{Binding SelectedFinding.OpenSystemMonitorCommand}"
                                                HorizontalAlignment="Left"
                                                Margin="0,12,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedFinding.ShowSystemMonitorAction}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="Open Startup Manager"
                                                Command="{Binding SelectedFinding.OpenStartupManagerCommand}"
                                                HorizontalAlignment="Left"
                                                Margin="0,12,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedFinding.ShowStartupManagerAction}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2"
                                Padding="16,11"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <TextBlock Text="Health Check does not apply changes. Action buttons open the relevant tool, where the user can review, select, confirm, and see results under that tool's existing safety rules."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  Visibility="{Binding IsCleanerContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="FILES FOUND" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding FilesFound}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" Background="#E8F2FC" CornerRadius="18">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RECLAIMABLE SPACE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding ReclaimableSpace}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" Background="#E6F6EE" CornerRadius="18">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SCAN STATUS / TIME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Margin="0,7,0,0" Text="{Binding ScanStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" Background="#F1EDF9" CornerRadius="18">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#7757B7" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Temporary files" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Only the current user's Windows temporary folder is scanned."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ScanCommand}" Content="Scan" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Command="{Binding CleanCommand}" Content="Clean selected" Style="{StaticResource CleanButtonStyle}" Margin="0,0,8,0" />
                        <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Candidates}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="True"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              Background="{StaticResource SurfaceBrush}"
                              AlternationCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SELECT" Width="74">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FILE NAME" Binding="{Binding Name}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="2*" MinWidth="180" />
                            <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="105" />
                            <DataGridTextColumn Header="MODIFIED" Binding="{Binding LastModified, StringFormat={}{0:dd MMM yyyy  HH:mm}}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="170" />
                            <DataGridTextColumn Header="LOCATION" Binding="{Binding FullPath}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="3*" MinWidth="240" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34" Background="#E6F6EE" CornerRadius="17">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="11,0,18,0">
                                <TextBlock Text="CLEANER STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Row="3"
                                   Margin="45,7,0,0"
                                   Text="{Binding Progress, StringFormat='Progress: {0}%'}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding CustomClean}"
                  Visibility="{Binding DataContext.IsCustomCleanContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CATEGORIES SELECTED" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedCategoriesText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="FILES FOUND" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding FilesFound}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="RECLAIMABLE SPACE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding ReclaimableSpace}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,16,0,12"
                        Padding="16,14"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="EXISTING CLEANER CATEGORIES" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <CheckBox Margin="0,8,0,0"
                                      IsChecked="{Binding IncludeTemporaryFiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Content="Current-user temporary files"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      Cursor="Hand">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                            <TextBlock Margin="22,3,0,0"
                                       Text="Uses the same current-user Windows temporary-folder scanner and safe cleanup service as Cleaner. Preview first; cleanup always requires confirmation."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Command="{Binding PreviewCommand}" Content="Preview" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding CleanCommand}" Content="Clean previewed" Style="{StaticResource CleanButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Results}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Background="{StaticResource SurfaceBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CATEGORY"
                                                Binding="{Binding Category}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="1.4*"
                                                MinWidth="150" />
                            <DataGridTextColumn Header="FILE NAME"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="1.6*"
                                                MinWidth="160" />
                            <DataGridTextColumn Header="SIZE"
                                                Binding="{Binding Size}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="100" />
                            <DataGridTextColumn Header="MODIFIED"
                                                Binding="{Binding LastModified, StringFormat={}{0:dd MMM yyyy  HH:mm}}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="165" />
                            <DataGridTextColumn Header="LOCATION"
                                                Binding="{Binding FullPath}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="2.6*"
                                                MinWidth="240" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34" Background="#E6F6EE" CornerRadius="17">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="11,0,18,0">
                                <TextBlock Text="CUSTOM CLEAN STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding PreviewStatus}" Foreground="{StaticResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Row="3"
                                   Margin="45,7,0,0"
                                   Text="{Binding Progress, StringFormat='Progress: {0}%'}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding AutoCleanSchedule}"
                  Visibility="{Binding DataContext.IsAutoCleanScheduleContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.Resources>
                    <Style x:Key="ScheduleSurfaceCardStyle" TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="12" />
                    </Style>
                    <Style x:Key="ScheduleSectionTitleStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style x:Key="ScheduleFieldLabelStyle" TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style x:Key="ScheduleListItemStyle" TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ScheduleCard"
                                            Padding="18,15"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Cursor="Hand">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ScheduleCard" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ScheduleCard" Property="Background" Value="#EEF6FF" />
                                            <Setter TargetName="ScheduleCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="ScheduleCard" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!-- Premium schedule overview -->
                <Grid Visibility="{Binding IsOverviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.45*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="20,16" Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="#EAF3FE" CornerRadius="10">
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Saved schedules" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding ScheduleCountText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Padding="20,16" Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="#EAF7F1" CornerRadius="10">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource SuccessBrush}"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Enabled" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding EnabledScheduleCountText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Padding="20,16" Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="#F2EEFF" CornerRadius="10">
                                    <TextBlock Text="&#xE823;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#7257C7"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Next planned run" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding NextPlannedRunText}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding NextPlannedRunText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,14,0,12"
                            Padding="16,12"
                            Background="#F5F9FE"
                            BorderBrush="#D9E9FA"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#E6F1FD" CornerRadius="15">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <TextBlock Text="Planning only — you remain in control"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Schedules are stored locally. They calculate future run times and support manual previews only; nothing runs or deletes files automatically."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource ScheduleSurfaceCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="22,18,22,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Your schedules" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Create separate plans for daily, weekly, or monthly maintenance."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding NewScheduleCommand}"
                                        Content="Create schedule"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="22,0,22,0">
                                <ListBox ItemsSource="{Binding Schedules}"
                                         SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource ScheduleListItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Visibility="{Binding HasSchedules, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="36" Height="36" Background="#EAF3FE" CornerRadius="10" VerticalAlignment="Top">
                                                    <TextBlock Text="&#xE823;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding FrequencyText}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Text="{Binding CategoriesText}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NextRunCaption}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="10" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding NextRunText}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border Grid.Column="4"
                                                        Margin="16,0,0,0"
                                                        Padding="11,5"
                                                        CornerRadius="12"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Background" Value="#EAF7F1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="#167A4B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Padding="34"
                                        Background="Transparent"
                                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                        <Border Width="62" Height="62" Background="#EAF3FE" CornerRadius="18" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE787;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="25"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Margin="0,18,0,0"
                                                   Text="No schedules yet"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="Create your first local maintenance plan. Each new schedule is saved separately and can be edited later."
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Margin="0,18,0,0"
                                                Command="{Binding NewScheduleCommand}"
                                                Content="Create first schedule"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="22,12"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedScheduleSummary}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding EditSelectedScheduleCommand}"
                                                Content="Edit selected"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0" />
                                        <Button Command="{Binding RemoveScheduleCommand}"
                                                Content="Remove"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,12,0,0"
                            Padding="16,11"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#EAF3FE" CornerRadius="15">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Schedule status" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding Status}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Dedicated create/edit page -->
                <Grid Visibility="{Binding IsEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding BackToSchedulesCommand}"
                                Content="←  Back to schedules"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EditorTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding EditorSubtitle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border MaxWidth="850"
                                Padding="28,24"
                                HorizontalAlignment="Center"
                                Style="{StaticResource ScheduleSurfaceCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" Background="#EAF3FE" CornerRadius="12">
                                        <TextBlock Text="&#xE787;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Schedule details" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Choose when this local maintenance plan should be considered due."
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,22,0,0" Text="Schedule name" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                <TextBox Height="42"
                                         Text="{Binding ScheduleName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="80"
                                         Style="{StaticResource InputTextBoxStyle}" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Frequency" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <ComboBox Height="42"
                                                  ItemsSource="{Binding Frequencies}"
                                                  SelectedItem="{Binding Frequency, Mode=TwoWay}"
                                                  Style="{StaticResource InputComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Local time (HH:mm)" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <TextBox Height="42"
                                                 Text="{Binding RunAtLocalTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <StackPanel Visibility="{Binding IsWeeklyFrequency, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Day of week" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <ComboBox Height="42"
                                                  ItemsSource="{Binding WeekDays}"
                                                  SelectedItem="{Binding WeeklyDay, Mode=TwoWay}"
                                                  Style="{StaticResource InputComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsMonthlyFrequency, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Day of month (1–31)" Style="{StaticResource ScheduleFieldLabelStyle}" />
                                        <TextBox Height="42"
                                                 Text="{Binding MonthlyDayText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,24,0,0"
                                        Padding="18,16"
                                        Background="{StaticResource SurfaceMutedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="Cleaner categories" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Only existing, safety-reviewed Cleaner categories can be included."
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" />
                                        <CheckBox Margin="0,14,0,0"
                                                  IsChecked="{Binding IncludeTemporaryFiles, Mode=TwoWay}"
                                                  Content="Current-user temporary files"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  Cursor="Hand" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,16,0,0"
                                        Padding="18,16"
                                        Background="#F5F9FE"
                                        BorderBrush="#D9E9FA"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Next planned run" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding EditorNextRunText}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsScheduleEnabled, Mode=TwoWay}"
                                                  Content="Enable schedule"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,16,0,0"
                                        Padding="18,16"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Preview this plan" Style="{StaticResource ScheduleSectionTitleStyle}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="Scan the selected categories without deleting or changing files."
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Command="{Binding PreviewNowCommand}"
                                                        Content="Preview now"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="0,0,8,0" />
                                                <Button Command="{Binding CancelPreviewCommand}"
                                                        Content="Cancel"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <ProgressBar Grid.Row="1"
                                                     Margin="0,14,0,0"
                                                     Height="5"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding PreviewProgress, Mode=OneWay}"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     Background="{StaticResource ProgressTrackBrush}" />

                                        <Grid Grid.Row="2" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource OperationMetaChipStyle}">
                                                <TextBlock Text="{Binding PreviewFilesFound, StringFormat='Files: {0}'}" Foreground="{StaticResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                                <TextBlock Text="{Binding PreviewReclaimableSpace, StringFormat='Space: {0}'}" Foreground="{StaticResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Grid.Column="4" Style="{StaticResource OperationMetaChipStyle}">
                                                <TextBlock Text="{Binding PreviewIssues, StringFormat='Issues: {0}'}" Foreground="{StaticResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding PreviewStatus}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock Margin="0,18,0,0"
                                           Text="Local storage"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SchedulesPath}"
                                           ToolTip="{Binding SchedulesPath}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="16,12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Status}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                <Button Command="{Binding BackToSchedulesCommand}"
                                        Content="Cancel"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0" />
                                <Button Command="{Binding SaveScheduleCommand}"
                                        Content="{Binding SaveButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding LargeFileFinder}"
                  Visibility="{Binding DataContext.IsLargeFileFinderContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="FILES FOUND" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding FilesFound}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TOTAL MATCHED SIZE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding TotalSize}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SCAN STATUS / TIME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,7,0,0" Text="{Binding ScanStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Margin="0,16,0,12" Padding="16,14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="300" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" MinWidth="130" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FOLDER OR DRIVE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding SelectedFolder}"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                    <Button Grid.Column="2" Command="{Binding BrowseCommand}" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MINIMUM SIZE (MB)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBox Margin="0,6,0,0"
                                         Text="{Binding MinimumSizeText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         HorizontalContentAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding ScanCommand}" Content="Scan" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding DeleteSelectedCommand}" Content="Delete selected" Style="{StaticResource CleanButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid x:Name="LargeFilesGrid"
                              ItemsSource="{Binding Results}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="True"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              Background="{StaticResource SurfaceBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SELECT" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FILE NAME" Binding="{Binding Name}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="2*" MinWidth="190" />
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="110" />
                            <DataGridTextColumn Header="MODIFIED" Binding="{Binding LastModified, StringFormat={}{0:dd MMM yyyy  HH:mm}}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="170" />
                            <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" ElementStyle="{StaticResource ResponsiveDataGridTextStyle}" IsReadOnly="True" Width="3*" MinWidth="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34" Background="#E6F6EE" CornerRadius="17">
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="11,0,18,0">
                                <TextBlock Text="LARGE FILE OPERATION STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Row="3"
                                   Margin="45,7,0,0"
                                   Text="{Binding ProgressText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding DuplicateFileFinder}"
                  Visibility="{Binding DataContext.IsDuplicateFileFinderContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="DUPLICATE GROUPS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding GroupsFound}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CONFIRMED FILES" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding DuplicateFiles}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="POTENTIAL RECLAIMABLE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding PotentialReclaimableSpace}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Margin="0,16,0,12" Padding="16,14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="FOLDER OR DRIVE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding SelectedFolder}"
                                         Style="{StaticResource InputTextBoxStyle}" />
                                <Button Grid.Column="2" Command="{Binding BrowseCommand}" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" />
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding SelectionSummary}"
                                       ToolTip="{Binding SelectionSummary}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Command="{Binding ScanCommand}" Content="Scan" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                                <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                                <Button Command="{Binding RecycleSelectedCommand}" Content="Recycle Selected" Style="{StaticResource CleanButtonStyle}" MinWidth="145" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid x:Name="DuplicateFilesGrid"
                              ItemsSource="{Binding GroupedResults}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="True"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              VerticalGridLinesBrush="{StaticResource BorderBrush}"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              Background="{StaticResource SurfaceMutedBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              FrozenColumnCount="1"
                              MinColumnWidth="54"
                              HorizontalContentAlignment="Stretch"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell"
                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Height" Value="38" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,10"
                                                Background="{StaticResource SurfaceMutedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="34"
                                                        Height="34"
                                                        Background="#F1EDF9"
                                                        CornerRadius="17">
                                                    <TextBlock Text="&#xE8B7;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="#7757B7"
                                                               FontSize="15"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Items[0].GroupTitle}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Items[0].GroupCopiesDisplay}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11" />
                                                        <TextBlock Margin="8,0" Text="&#x2022;" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Items[0].GroupRemovalGuidance}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="3"
                                                        Padding="10,6"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="EACH FILE"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding Items[0].GroupSizeDisplay}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="5"
                                                        Padding="10,6"
                                                        Background="#E6F6EE"
                                                        BorderBrush="#B8E2CA"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="RECLAIMABLE"
                                                                   Foreground="#23764C"
                                                                   FontSize="9"
                                                                   FontWeight="Bold" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding Items[0].GroupReclaimableDisplay}"
                                                                   Foreground="#17613C"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Margin" Value="0,8,0,10" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Border Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0,1,0,1"
                                                            CornerRadius="0"
                                                            ClipToBounds="True"
                                                            HorizontalAlignment="Stretch">
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <ContentPresenter Grid.Row="0"
                                                                              Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                              HorizontalAlignment="Stretch" />
                                                            <ItemsPresenter Grid.Row="1"
                                                                            HorizontalAlignment="Stretch" />
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SELECT"
                                                    Width="58"
                                                    MinWidth="58"
                                                    MaxWidth="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FILE NAME"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="2*"
                                                MinWidth="220" />
                            <DataGridTextColumn Header="SIZE"
                                                Binding="{Binding SizeDisplay}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="90"
                                                MinWidth="90"
                                                MaxWidth="110" />
                            <DataGridTextColumn Header="MODIFIED"
                                                Binding="{Binding LastModified, StringFormat={}{0:g}}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="145"
                                                MinWidth="135"
                                                MaxWidth="175" />
                            <DataGridTextColumn Header="LOCATION"
                                                Binding="{Binding Location}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="3*"
                                                MinWidth="320" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34" Background="#F1EDF9" CornerRadius="17">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#7757B7" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="11,0,18,0">
                                <TextBlock Text="DUPLICATE OPERATION STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ContentControl Grid.Row="2"
                                        Content="{Binding OperationResult}"
                                        ContentTemplate="{StaticResource OperationResultSummaryTemplate}"
                                        Visibility="{Binding OperationResult.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Row="3"
                                   Margin="45,7,0,0"
                                   Text="{Binding ProgressText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding StartupManager}"
                  Visibility="{Binding DataContext.IsStartupManagerContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="STARTUP ITEMS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding ItemsFound}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ENABLED" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding EnabledItems}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="DISABLED" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding DisabledItems}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Margin="0,16,0,12" Padding="16,14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="READ-ONLY STARTUP INVENTORY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="Registry Run entries and current-user/all-users Startup folders. Nothing can be enabled, disabled, edited, or removed here."
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ScanCommand}" Content="Scan" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Results}"
                              behaviors:DataGridSelectionBehavior.IsEnabled="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Background="{StaticResource SurfaceBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="1.2*"
                                                MinWidth="90" />
                            <DataGridTextColumn Header="COMMAND / PATH"
                                                Binding="{Binding Command}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="2.4*"
                                                MinWidth="150" />
                            <DataGridTextColumn Header="SOURCE"
                                                Binding="{Binding Source}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="1.5*"
                                                MinWidth="110" />
                            <DataGridTextColumn Header="LOCATION"
                                                Binding="{Binding Location}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="2*"
                                                MinWidth="140" />
                            <DataGridTextColumn Header="STATUS"
                                                Binding="{Binding Status}"
                                                ElementStyle="{StaticResource ResponsiveDataGridTextStyle}"
                                                IsReadOnly="True"
                                                Width="1.2*"
                                                MinWidth="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource ProgressTrackBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34" Background="#E8F2FC" CornerRadius="17">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="11,0,18,0">
                                <TextBlock Text="STARTUP INVENTORY STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Margin="45,7,0,0"
                                   Text="{Binding ProgressText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding SystemMonitor}"
                  Visibility="{Binding DataContext.IsSystemMonitorContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CPU USAGE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding CpuUsageText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MEMORY USAGE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding MemoryUsageText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MEMORY USED" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding UsedMemoryText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,16,0,12"
                        Padding="16,14"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="READ-ONLY LIVE MONITOR" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="Samples total system CPU usage and physical memory approximately once per second. It does not stop processes, optimize memory, or change Windows settings."
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="18,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding StartCommand}" Content="Start" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding StopCommand}" Content="Stop" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="20"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="TOTAL CPU" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,10,0,10"
                                       Text="{Binding CpuUsageText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="34"
                                       FontWeight="SemiBold" />
                            <ProgressBar Grid.Row="2"
                                         Height="12"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding CpuUsagePercent, Mode=OneWay}"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="{StaticResource ProgressTrackBrush}" />
                            <TextBlock Grid.Row="3"
                                       Margin="0,14,0,0"
                                       Text="Overall processor activity across Windows"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="20"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="PHYSICAL MEMORY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,10,0,10"
                                       Text="{Binding MemoryUsageText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="34"
                                       FontWeight="SemiBold" />
                            <ProgressBar Grid.Row="2"
                                         Height="12"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding MemoryUsagePercent, Mode=OneWay}"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="{StaticResource ProgressTrackBrush}" />

                            <Grid Grid.Row="3" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="USED" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding UsedMemoryText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="AVAILABLE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding AvailableMemoryText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TOTAL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding TotalMemoryText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34" Background="#E8F2FC" CornerRadius="17">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="11,0,18,0">
                                <TextBlock Text="MONITOR STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding MonitoringState}" Foreground="{StaticResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="45,7,0,0"
                                   Text="{Binding LastUpdated, StringFormat='Last updated: {0}'}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>


            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding Settings}"
                  Visibility="{Binding DataContext.IsSettingsContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Border Padding="18"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" MinWidth="180" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="1*" MinWidth="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="APPEARANCE"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Theme"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="System follows the current Windows app theme. Changes apply immediately."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          MinWidth="180"
                                          MaxWidth="300"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                          Style="{StaticResource InputComboBoxStyle}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="OPERATING DEFAULTS"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*" MinWidth="170" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1*" MinWidth="130" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1.55*" MinWidth="170" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Large File Finder default"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Minimum file size in MB used when the app starts."
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding LargeFileMinimumSizeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="MB"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Column="4"
                                               Text="Allowed range: 1 MB to 1,048,576 MB."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Border Margin="0,14,0,14"
                                        Height="1"
                                        Background="{StaticResource BorderBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*" MinWidth="170" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1*" MinWidth="130" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1.55*" MinWidth="170" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="System Monitor refresh"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Time between live CPU and memory updates."
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SystemMonitorRefreshIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="seconds"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Column="4"
                                               Text="Allowed range: 1 to 10 seconds."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" MinWidth="170" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="2.2*" MinWidth="280" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SAFETY POLICY"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Cleanup confirmation"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <CheckBox IsChecked="{Binding ConfirmBeforeCleanup, Mode=OneWay}"
                                              IsEnabled="False"
                                              Content="Always require confirmation before cleanup"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="This safety setting is mandatory and cannot be disabled. System Performance Accelerator never deletes or recycles files without explicit confirmation."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="LOCAL STORAGE"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Settings are saved as a local JSON file. No cloud account, telemetry, or registry writing is used."
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding SettingsPath}"
                                           ToolTip="{Binding SettingsPath}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="34" Height="34" Background="#E8F2FC" CornerRadius="17">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="11,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="SETTINGS STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding Status}"
                                       ToolTip="{Binding Status}"
                                       Style="{StaticResource OperationStatusMessageStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding RestoreDefaultsCommand}"
                                    Content="Restore defaults"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Command="{Binding SaveCommand}"
                                    Content="Save settings"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>


        </Grid>
    </Grid>
</Window>
