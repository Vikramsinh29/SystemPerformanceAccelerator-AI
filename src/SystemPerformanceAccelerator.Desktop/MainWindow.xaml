                                Command="{Binding CloseRepairPlanPreviewCommand}"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                Content="Close preview"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Grid>


            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding SystemMonitor}"
                  Visibility="{Binding DataContext.IsSystemMonitorContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModuleHeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentSoftBrush}" Style="{StaticResource ModuleHeroIconStyle}"><TextBlock Text="&#xE9D2;" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource ModuleHeroGlyphStyle}" /></Border>
                        <StackPanel Grid.Column="1" Margin="16,0,22,0" VerticalAlignment="Center"><TextBlock Text="Live system telemetry" Style="{StaticResource ModuleHeroTitleStyle}" /><TextBlock Text="Read total CPU and physical-memory activity without stopping processes, optimizing memory, or changing Windows." Style="{StaticResource ModuleHeroDescriptionStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding StartCommand}" Style="{StaticResource FluentPrimaryButtonStyle}" Margin="0,0,8,0" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Start monitoring" VerticalAlignment="Center" /></StackPanel></Button><Button Command="{Binding StopCommand}" Style="{StaticResource FluentSecondaryButtonStyle}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Stop" VerticalAlignment="Center" /></StackPanel></Button></StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="18,14" Style="{StaticResource FluentCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="&#xE9D9;" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CPU USAGE" Style="{StaticResource FluentCaptionStyle}" /><TextBlock Text="{Binding CpuUsageText}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /></StackPanel></Grid></Border>
                    <Border Grid.Column="2" Padding="18,14" Style="{StaticResource FluentCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource SuccessSoftBrush}"><TextBlock Text="&#xE950;" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="MEMORY USAGE" Style="{StaticResource FluentCaptionStyle}" /><TextBlock Text="{Binding MemoryUsageText}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /></StackPanel></Grid></Border>
                    <Border Grid.Column="4" Padding="18,14" Style="{StaticResource FluentCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource SummaryMetricIconStyle}" Background="{DynamicResource WarningSoftBrush}"><TextBlock Text="&#xE8C8;" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource SummaryMetricGlyphStyle}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="MEMORY USED" Style="{StaticResource FluentCaptionStyle}" /><TextBlock Text="{Binding UsedMemoryText}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SummaryMetricValueStyle}" /></StackPanel></Grid></Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="20"
                            Style="{StaticResource FluentElevatedCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="TOTAL CPU" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,10,0,10"
                                       Text="{Binding CpuUsageText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="34"
                                       FontWeight="SemiBold" />
                            <ProgressBar Grid.Row="2"
                                         Height="12"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding CpuUsagePercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ProgressTrackBrush}" />
                            <Grid Grid.Row="3" Margin="0,18,0,10" MinHeight="150">
                                <TextBlock Text="60-SAMPLE LIVE HISTORY"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top" />
                                <controls:LiveHistoryChart Margin="0,24,0,0"
                                                           Values="{Binding CpuUsageHistory}"
                                                           Stroke="{DynamicResource AccentBrush}"
                                                           Fill="{DynamicResource AccentSoftBrush}"
                                                           GridLine="{DynamicResource BorderBrush}" />
                                <TextBlock Text="Waiting for first sample"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasHistory}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Grid.Row="4"
                                       Margin="0,4,0,0"
                                       Text="Overall processor activity across Windows"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="20"
                            Style="{StaticResource FluentElevatedCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="PHYSICAL MEMORY" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,10,0,10"
                                       Text="{Binding MemoryUsageText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="34"
                                       FontWeight="SemiBold" />
                            <ProgressBar Grid.Row="2"
                                         Height="12"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding MemoryUsagePercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ProgressTrackBrush}" />

                            <Grid Grid.Row="3" Margin="0,18,0,10" MinHeight="150">
                                <TextBlock Text="60-SAMPLE LIVE HISTORY"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top" />
                                <controls:LiveHistoryChart Margin="0,24,0,0"
                                                           Values="{Binding MemoryUsageHistory}"
                                                           Stroke="{DynamicResource SuccessBrush}"
                                                           Fill="{DynamicResource SuccessSoftBrush}"
                                                           GridLine="{DynamicResource BorderBrush}" />
                                <TextBlock Text="Waiting for first sample"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasHistory}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="USED" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding UsedMemoryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="AVAILABLE" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding AvailableMemoryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TOTAL" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding TotalMemoryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource OperationStatusIconStyle}">
                                <TextBlock Text="&#xE9D2;" Style="{StaticResource OperationStatusGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="MONITOR STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Status}"
                                           ToolTip="{Binding Status}"
                                           Style="{StaticResource OperationStatusMessageStyle}" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource OperationMetaChipStyle}">
                                <TextBlock Text="{Binding MonitoringState}" Foreground="{DynamicResource MetaTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="45,7,0,0"
                                   Text="{Binding LastUpdated, StringFormat='Last updated: {0}'}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Grid>


            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding Help}"
                  Visibility="{Binding DataContext.IsHelpContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Border Margin="0,0,0,14"
                                Style="{StaticResource ModuleHeroCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource AccentSoftBrush}"
                                        Style="{StaticResource ModuleHeroIconStyle}">
                                    <TextBlock Text="&#xE897;"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Style="{StaticResource ModuleHeroGlyphStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="16,0,22,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Find the right tool for your problem"
                                               Style="{StaticResource ModuleHeroTitleStyle}" />
                                    <TextBlock Text="Search by symptom or goal, understand what each tool does, and follow its safest workflow."
                                               Style="{StaticResource ModuleHeroDescriptionStyle}" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Style="{StaticResource OperationMetaChipStyle}">
                                    <TextBlock Text="Offline guidance"
                                               Foreground="{DynamicResource MetaTextBrush}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,14"
                                Padding="18"
                                Style="{StaticResource FluentCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="WHAT DO YOU NEED HELP WITH?"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBox Margin="0,8,0,0"
                                             MinHeight="40"
                                             Padding="12,8"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Try storage, startup, duplicate, Windows repair, CPU, or cleanup" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Margin="12,20,8,0"
                                        Style="{StaticResource OperationMetaChipStyle}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VisibleGuideCountText}"
                                               Foreground="{DynamicResource MetaTextBrush}"
                                               FontSize="11" />
                                </Border>
                                <Button Grid.Column="2"
                                        Margin="0,20,0,0"
                                        Command="{Binding ClearSearchCommand}"
                                        Content="Clear"
                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,14"
                                Padding="18"
                                Background="{DynamicResource SuccessSoftBrush}"
                                BorderBrush="{DynamicResource SuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Safety first"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Start with a scan or assessment, review full paths and results, select only items you understand, and read every confirmation. PC-SPA does not clean, recycle, disable, or repair automatically."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="2,0,0,10"
                                   Text="PROBLEM-BASED GUIDES"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />

                        <ItemsControl ItemsSource="{Binding FilteredGuides}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="500"
                                            MinHeight="360"
                                            Margin="0,0,12,12"
                                            Padding="18"
                                            Style="{StaticResource FluentCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Problem}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{Binding Summary}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Style="{StaticResource OperationMetaChipStyle}"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding ToolName}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Margin="0,14,0,0"
                                                       Text="WHEN TO USE"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold" />
                                            <TextBlock Grid.Row="2"
                                                       Margin="0,4,0,0"
                                                       Text="{Binding WhenToUse}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />

                                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                                <TextBlock Text="USE WITH CARE"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding WhenNotToUse}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                                <TextBlock Text="SAFE WORKFLOW"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding Steps}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Border Grid.Row="5"
                                                    Margin="0,12,0,0"
                                                    Padding="10"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding SafetyNote}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="10.5"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <Button Grid.Row="6"
                                                    Margin="0,14,0,0"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding OpenToolCommand}"
                                                    Content="Open this tool"
                                                    Style="{StaticResource FluentPrimaryButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,4,0,0"
                                Padding="22"
                                Style="{StaticResource FluentCardStyle}"
                                Visibility="{Binding HasNoVisibleGuides, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No matching guide found"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Try a broader word such as storage, startup, repair, cleanup, duplicate, CPU, or memory."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>


            <Grid Grid.Row="1"
                  Margin="20,16,20,18"
                  DataContext="{Binding Settings}"
                  Visibility="{Binding DataContext.IsSettingsContentVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch">
                        <StackPanel.Resources>
                            <Style x:Key="SettingsPageButtonStyle"
                                   TargetType="Button"
                                   BasedOn="{StaticResource FluentSecondaryButtonStyle}">
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="Padding" Value="14,8" />
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>

                        <Border Margin="0,0,0,14" Style="{StaticResource ModuleHeroCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource AccentSoftBrush}" Style="{StaticResource ModuleHeroIconStyle}"><TextBlock Text="&#xE713;" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource ModuleHeroGlyphStyle}" /></Border>
                                <StackPanel Grid.Column="1" Margin="16,0,22,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DataContext.SettingsPageTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Style="{StaticResource ModuleHeroTitleStyle}" />
                                    <TextBlock Text="{Binding DataContext.SettingsPageDescription, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Style="{StaticResource ModuleHeroDescriptionStyle}" />
                                </StackPanel>
                                <Border Grid.Column="2" Padding="10,6" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" VerticalAlignment="Center"><TextBlock Text="Focused settings pages" Foreground="{DynamicResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold" /></Border>
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,14"
                                Padding="12,12,4,4"
                                Style="{StaticResource FluentCardStyle}">
                            <WrapPanel>
                                <Button Command="{Binding DataContext.ShowSettingsGeneralCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Tag="{Binding DataContext.IsGeneralSettingsPage, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource SettingsPageButtonStyle}"
                                        Content="General" />
                                <Button Command="{Binding DataContext.ShowSettingsAccountActivationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Tag="{Binding DataContext.IsAccountActivationSettingsPage, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource SettingsPageButtonStyle}"
                                        Content="Account &amp; Activation" />
                                <Button Command="{Binding DataContext.ShowSettingsDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Tag="{Binding DataContext.IsDiagnosticsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource SettingsPageButtonStyle}"
                                        Content="Diagnostics" />
                                <Button Command="{Binding DataContext.ShowSettingsFeedbackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Tag="{Binding DataContext.IsFeedbackSettingsPage, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource SettingsPageButtonStyle}"
                                        Content="Feedback" />
                                <Button Command="{Binding DataContext.ShowSettingsAboutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Tag="{Binding DataContext.IsAboutSettingsPage, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource SettingsPageButtonStyle}"
                                        Content="About" />
                            </WrapPanel>
                        </Border>

                        <Border Margin="0,0,0,14"
                                Padding="18"
                                Style="{StaticResource FluentCardStyle}"
                                Visibility="{Binding DataContext.IsAccountActivationSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="OPEN BETA ACCESS"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="No account or activation key is required"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="10,6"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="12"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="BETA ACCESS OPEN"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <TextBlock Margin="0,12,0,0"
                                           Text="All locally available Beta features can be used without signing in or activating this PC. This build remains available for 30 days from its official release date."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Border Margin="0,0,8,6"
                                            Style="{StaticResource OperationMetaChipStyle}">
                                        <TextBlock Text="{Binding DataContext.BetaBuildReleaseText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{DynamicResource MetaTextBrush}"
                                                   FontSize="10.5" />
                                    </Border>
                                    <Border Margin="0,0,0,6"
                                            Style="{StaticResource OperationMetaChipStyle}">
                                        <TextBlock Text="{Binding DataContext.BetaBuildExpiryText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{DynamicResource MetaTextBrush}"
                                                   FontSize="10.5" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,14"
                                Padding="18"
                                Style="{StaticResource FluentCardStyle}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CONTROLLED BETA ACCESS"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="Sign in and activate PC-SPA on this computer"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="10,6"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="12"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BetaAccessStateText}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding BetaAccessMessage}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,14,0,0"
                                           Text="Account"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SignInEmail, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Enter the email address used for your PC-SPA account"
                                             Style="{StaticResource FluentTextBoxStyle}" />
                                    <PasswordBox Grid.Column="2"
                                                 behaviors:PasswordBoxBindingBehavior.BoundPassword="{Binding SignInPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Enter the password for your PC-SPA account"
                                                 Style="{StaticResource InputPasswordBoxStyle}" />
                                    <Button Grid.Column="4"
                                            Command="{Binding SignInCommand}"
                                            Style="{StaticResource FluentPrimaryButtonStyle}">
                                        <TextBlock Text="{Binding SignInActionText}" />
                                    </Button>
                                    <Button Grid.Column="6"
                                            Command="{Binding SignOutCommand}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}">
                                        <TextBlock Text="Sign out" />
                                    </Button>
                                </Grid>

                                <Border Margin="0,10,0,0"
                                        Style="{StaticResource OperationMetaChipStyle}">
                                    <TextBlock Text="{Binding SignInStateText}"
                                               Foreground="{DynamicResource MetaTextBrush}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding SignedInIdentityText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding SignInMessage}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,16,0,0"
                                           Text="Activation"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BetaAccessCode, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="64"
                                             ToolTip="Enter the PCSPA access code supplied by the beta administrator"
                                             Style="{StaticResource FluentTextBoxStyle}" />
                                    <Button Grid.Column="2"
                                            Command="{Binding ActivateBetaAccessCommand}"
                                            Style="{StaticResource FluentPrimaryButtonStyle}">
                                        <TextBlock Text="{Binding BetaAccessActionText}" />
                                    </Button>
                                    <Button Grid.Column="4"
                                            Command="{Binding RefreshBetaAccessCommand}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}">
                                        <TextBlock Text="Verify status" />
                                    </Button>
                                </Grid>
                                <Button Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DeactivateBetaAccessCommand}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}">
                                    <TextBlock Text="Deactivate this PC" />
                                </Button>

                                <WrapPanel Margin="0,12,0,0">
                                    <Border Margin="0,0,8,6"
                                            Style="{StaticResource OperationMetaChipStyle}">
                                        <TextBlock Text="{Binding BetaAccessReferenceText}"
                                                   Foreground="{DynamicResource MetaTextBrush}"
                                                   FontSize="10.5" />
                                    </Border>
                                    <Border Margin="0,0,0,6"
                                            Style="{StaticResource OperationMetaChipStyle}">
                                        <TextBlock Text="{Binding BetaAccessExpiryText}"
                                                   Foreground="{DynamicResource MetaTextBrush}"
                                                   FontSize="10.5" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Margin="0,5,0,0"
                                           Text="Your password is never stored. The activation key is discarded after each request. Only the returned session or license token is stored securely for the current Windows user."
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,14"
                                Padding="18,14"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Visibility="{Binding DataContext.IsDiagnosticsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42"
                                        Height="42"
                                        Background="{DynamicResource PanelBrush}"
                                        CornerRadius="9">
                                    <TextBlock Text="&#xE7BA;"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="19"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="14,0,20,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Encountered a problem?"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding RecordedErrorActionText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Command="{Binding DataContext.ShowSettingsFeedbackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource FluentPrimaryButtonStyle}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Text="Report an error"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Padding="18"
                                Style="{StaticResource FluentCardStyle}"
                                Visibility="{Binding DataContext.IsGeneralSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" MinWidth="180" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="1*" MinWidth="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="APPEARANCE"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Theme"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="System follows the current Windows app theme. Changes apply immediately."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          MinWidth="180"
                                          MaxWidth="300"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                          Style="{StaticResource FluentComboBoxStyle}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Style="{StaticResource FluentCardStyle}"
                                Visibility="{Binding DataContext.IsGeneralSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="OPERATING DEFAULTS"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*" MinWidth="170" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1*" MinWidth="130" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1.55*" MinWidth="170" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Large File Finder default"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Minimum file size in MB used when the app starts."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding LargeFileMinimumSizeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FluentTextBoxStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="MB"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Column="4"
                                               Text="Allowed range: 1 MB to 1,048,576 MB."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Border Margin="0,14,0,14"
                                        Height="1"
                                        Background="{DynamicResource BorderBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*" MinWidth="170" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1*" MinWidth="130" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1.55*" MinWidth="170" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="System Monitor refresh"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Time between live CPU and memory updates."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SystemMonitorRefreshIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FluentTextBoxStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="seconds"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Column="4"
                                               Text="Allowed range: 1 to 10 seconds."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Style="{StaticResource FluentCardStyle}"
                                Visibility="{Binding DataContext.IsGeneralSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" MinWidth="170" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="2.2*" MinWidth="280" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SAFETY POLICY"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Cleanup confirmation"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <CheckBox IsChecked="{Binding ConfirmBeforeCleanup, Mode=OneWay}"
                                              IsEnabled="False"
                                              Content="Always require confirmation before cleanup"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              FontWeight="SemiBold" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="This safety setting is mandatory and cannot be disabled. PC-SPA never deletes or recycles files without explicit confirmation."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Style="{StaticResource FluentCardStyle}"
                                Visibility="{Binding DataContext.IsDiagnosticsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="LOCAL DIAGNOSTICS"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="Privacy-safe diagnostic evidence"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Unexpected errors can be recorded locally for support. Nothing is uploaded automatically, and exports require your review and confirmation."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Margin="16,0,0,0"
                                            Padding="10,6"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="12"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding DiagnosticsEnabledStatus}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <CheckBox Margin="0,14,0,0"
                                          IsChecked="{Binding LocalDiagnosticsEnabled, Mode=TwoWay}"
                                          Content="Enable privacy-safe local diagnostics"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontWeight="SemiBold" />

                                <CheckBox Margin="0,8,0,0"
                                          IsChecked="{Binding IncludeHardwareSummaryInDiagnosticExport, Mode=TwoWay}"
                                          IsEnabled="{Binding LocalDiagnosticsEnabled}"
                                          Content="Include a basic CPU and memory summary in manual diagnostic exports"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />

                                <TextBlock Margin="24,5,0,0"
                                           Text="{Binding DiagnosticExportPolicyText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />

                                <Border Margin="0,14,0,14"
                                        Height="1"
                                        Background="{DynamicResource BorderBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" MinWidth="180" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="1*" MinWidth="180" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="APPLICATION"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding DiagnosticVersionText}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="0,12,0,0"
                                                   Text="WINDOWS / PRIVILEGE"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding DiagnosticWindowsText}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding DiagnosticElevationText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10.5" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RUNTIME"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding DiagnosticRuntimeText}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="0,12,0,0"
                                                   Text="ANONYMOUS INSTALLATION ID"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding InstallationIdText}"
                                                   ToolTip="{Binding InstallationIdText}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="0,12,0,0"
                                                   Text="LATEST ERROR REFERENCE"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding LatestErrorReferenceText}"
                                                   ToolTip="{Binding LatestErrorReferenceText}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,14,0,0"
                                           Text="{Binding DiagnosticsPath}"
                                           ToolTip="{Binding DiagnosticsPath}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Command="{Binding OpenDiagnosticsFolderCommand}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                            <TextBlock Margin="8,0,0,0" Text="Open diagnostics folder" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding ExportDiagnosticPackageCommand}"
                                            Style="{StaticResource FluentPrimaryButtonStyle}"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                            <TextBlock Margin="8,0,0,0" Text="Preview &amp; export package" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding CopyLatestErrorReferenceCommand}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                            <TextBlock Margin="8,0,0,0" Text="Copy error reference" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding DeleteDiagnosticHistoryCommand}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                            <TextBlock Margin="8,0,0,0" Text="Delete diagnostic history" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding ResetInstallationIdCommand}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                            Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                            <TextBlock Margin="8,0,0,0" Text="Reset installation ID" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BetaErrorFeedbackCard"
                                Margin="0,14,0,0"
                                Padding="18"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Visibility="{Binding DataContext.IsFeedbackSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="BETA ERROR FEEDBACK"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Your privacy stays protected"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="PC-SPA will include only your error description and the minimum application and Windows information needed to investigate it. Personal files, file contents, passwords, browser activity, email addresses, licence keys, cookies, Windows username, computer name, and full personal paths are excluded or redacted. Nothing is sent automatically; sending occurs only after your preview and confirmation."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="AFFECTED TOOL OR PAGE"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBox Margin="0,5,0,0"
                                                 Text="{Binding FeedbackAffectedArea, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="80"
                                                 Style="{StaticResource FluentTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WHAT HAPPENED"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBox Margin="0,5,0,0"
                                                 Text="{Binding FeedbackDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="1200"
                                                 MinHeight="58"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource FluentTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,12,0,0"
                                           Text="EXPECTED RESULT (OPTIONAL)"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding FeedbackExpectedResult, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="600"
                                         Style="{StaticResource FluentTextBoxStyle}" />

                                <CheckBox Margin="0,12,0,0"
                                          IsChecked="{Binding IncludeSanitizedDiagnosticsInFeedback}"
                                          Content="Include locally recorded, sanitized diagnostic events"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />
                                <CheckBox Margin="0,8,0,0"
                                          IsChecked="{Binding FeedbackConsent}"
                                          Content="I have reviewed this information and agree to send this privacy-safe technical error report to the PC-SPA development team."
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontWeight="SemiBold" />

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Command="{Binding CreateFeedbackPackageCommand}"
                                            Style="{StaticResource FluentPrimaryButtonStyle}"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                            <TextBlock Margin="8,0,0,0"
                                                       Text="Preview &amp; send error report"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DismissRecordedErrorCommand}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                            Margin="0,0,0,8"
                                            Visibility="{Binding HasUnreviewedDiagnosticError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                            <TextBlock Margin="8,0,0,0"
                                                       Text="Dismiss this error"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <Border Margin="0,8,0,0"
                                        Padding="12"
                                        Background="{DynamicResource SuccessSoftBrush}"
                                        BorderBrush="{DynamicResource SuccessBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding HasSubmittedFeedbackReference, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding CopySubmittedFeedbackReferenceCommand}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource ActionButtonGlyphStyle}" />
                                                <TextBlock Margin="8,0,0,0" Text="Copy reference" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="REPORT RECEIVED"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding SubmittedFeedbackReferenceText}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Style="{StaticResource BrandAboutCardStyle}"
                                Visibility="{Binding DataContext.IsAboutSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Width="240"
                                       Height="240"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{DynamicResource BrandPhoenixSource}"
                                       Style="{StaticResource BrandImageStyle}"
                                       ToolTip="PC-SPA phoenix emblem" />

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="ABOUT PC-SPA"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <Image Margin="0,8,0,0"
                                           Width="280"
                                           Height="102"
                                           HorizontalAlignment="Left"
                                           Source="{DynamicResource BrandWordmarkSource}"
                                           Style="{StaticResource BrandImageStyle}" />
                                    <TextBlock Margin="2,2,0,0"
                                               Text="SYSTEM PERFORMANCE"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="2,3,0,0"
                                               Text="A C C E L E R A T O R"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />

                                    <WrapPanel Margin="0,12,0,0">
                                        <Border Margin="0,0,8,6" Style="{StaticResource OperationMetaChipStyle}">
                                            <TextBlock Text="{Binding DataContext.ApplicationVersion, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="{DynamicResource MetaTextBrush}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <Border Margin="0,0,8,6" Style="{StaticResource OperationMetaChipStyle}">
                                            <TextBlock Text="Windows 10/11 desktop"
                                                       Foreground="{DynamicResource MetaTextBrush}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <Border Margin="0,0,0,6" Style="{StaticResource OperationMetaChipStyle}">
                                            <TextBlock Text="Offline-first"
                                                       Foreground="{DynamicResource MetaTextBrush}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Margin="0,5,0,0"
                                               Text="A local system utility with no cloud account, telemetry, or automatic deletion. Every cleanup remains review-first and confirmation-required."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="github.com/Vikramsinh29/SystemPerformanceAccelerator-AI"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontSize="10.5"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="https://github.com/Vikramsinh29/SystemPerformanceAccelerator-AI" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding DataContext.IsAboutSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="LOCAL STORAGE"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Settings are saved as a local JSON file. No cloud account, telemetry, or registry writing is used."
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding SettingsPath}"
                                           ToolTip="{Binding SettingsPath}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Style="{StaticResource OperationStatusPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource OperationStatusIconStyle}">
                            <TextBlock Text="&#xE713;" Style="{StaticResource OperationStatusGlyphStyle}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="SETTINGS STATUS" Style="{StaticResource OperationStatusLabelStyle}" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding Status}"
                                       ToolTip="{Binding Status}"
                                       Style="{StaticResource OperationStatusMessageStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding RestoreDefaultsCommand}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Margin="0,0,8,0" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Restore defaults" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Command="{Binding SaveCommand}"
                                    Style="{StaticResource FluentPrimaryButtonStyle}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource ActionButtonGlyphStyle}" /><TextBlock Margin="8,0,0,0" Text="Save settings" VerticalAlignment="Center" /></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            </Grid>
            </ScrollViewer>
        </Grid>
            </Grid>

            <Grid Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Panel.ZIndex="100"
                  Background="{DynamicResource AppBackgroundBrush}"
                  Visibility="{Binding IsBetaAccessGateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="560"
                        MaxWidth="560"
                        Margin="32"
                        Padding="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="CONTROLLED BETA ACCESS"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="Activate PC-SPA on this computer"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,9,0,0"
                                   Text="This controlled beta requires sign-in and a valid activation key. If this PC is already activated, retry verification to restore access."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,22,0,0"
                                Padding="14,11"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding Settings.BetaAccessStateText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="11"
                                           FontWeight="Bold" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding Settings.BetaAccessMessage}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,0"
                                   Text="Account"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBox Margin="0,10,0,0"
                                 Text="{Binding Settings.SignInEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="Enter the email address used for your PC-SPA account" />
                        <PasswordBox Margin="0,10,0,0"
                                     behaviors:PasswordBoxBindingBehavior.BoundPassword="{Binding Settings.SignInPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputPasswordBoxStyle}"
                                     ToolTip="Enter the password for your PC-SPA account" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Command="{Binding Settings.SignInCommand}"
                                    Style="{StaticResource FluentPrimaryButtonStyle}">
                                <TextBlock Text="{Binding Settings.SignInActionText}" />
                            </Button>
                            <Button Margin="10,0,0,0"
                                    Command="{Binding Settings.SignOutCommand}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Content="Sign out" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding Settings.SignInStateText}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding Settings.SignedInIdentityText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding Settings.SignInMessage}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,18,0,0"
                                   Text="Activation"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBox Margin="0,10,0,0"
                                 Text="{Binding Settings.BetaAccessCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="Enter the controlled-beta invitation code" />

                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <Button Command="{Binding Settings.ActivateBetaAccessCommand}"
                                    Style="{StaticResource FluentPrimaryButtonStyle}">
                                <TextBlock Text="{Binding Settings.BetaAccessActionText}" />
                            </Button>
                            <Button Margin="10,0,0,0"
                                    Command="{Binding Settings.RefreshBetaAccessCommand}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Content="Retry verification" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding Settings.DeactivateBetaAccessCommand}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Content="Deactivate this PC" />
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0"
                                   Text="Temporary service outages will not permanently lock this PC. If the saved license cannot be verified during a short outage, PC-SPA keeps local access available until verification can be retried."
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Panel.ZIndex="101"
                  Background="{DynamicResource AppBackgroundBrush}"
                  Visibility="{Binding IsBetaAccessInitializing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="PC-SPA"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <ProgressBar Width="220"
                                 Height="3"
                                 Margin="0,18,0,0"
                                 IsIndeterminate="True" />
                    <TextBlock Margin="0,12,0,0"
                               Text="Checking access…"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
