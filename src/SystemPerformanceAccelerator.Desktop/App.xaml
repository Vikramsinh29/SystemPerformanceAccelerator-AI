<Application x:Class="SystemPerformanceAccelerator.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:SystemPerformanceAccelerator.Desktop.Behaviors"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="behaviors:DataGridSelectionBehavior.IsEnabled" Value="True" />
        </Style>
    </Application.Resources>
</Application>
