{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pc-spa-licensing-v2-staging",
  "main": "src/staging-entrypoint.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "vars": {
    "STAGING_ACCOUNT_ID": "pcspa-staging-account"
  },
  "d1_databases": [
    {
      "binding": "LICENSING_DB",
      "database_name": "pc-spa-licensing-v2-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
