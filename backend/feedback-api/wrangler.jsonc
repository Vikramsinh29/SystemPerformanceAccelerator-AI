{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pc-spa-feedback-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "pc-spa-feedback",
      "database_id": "d1b96514-c9da-4ac2-a2de-c7fa2509a020",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
